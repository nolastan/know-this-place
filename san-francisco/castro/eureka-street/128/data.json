  "historical_record": [
    {
      "date": "1900",
      "kind": "business",
      "description": "Eggers & Company ran a soda and mineral water manufactory and bottling works from the rear ell of the house and then a series of small outbuildings, advertising itself as a dealer in natural mineral waters and a manufacturer of soda water and superior ginger ale. The firm had previously sold mineral water from the Tolenas Springs in Solano County and appears to have gone on bottling Tolenas spring water here until about 1903.",
      "source": "eureka-valley-context-statement"
