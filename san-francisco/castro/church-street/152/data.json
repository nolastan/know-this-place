  "historic_survey": {
    "survey": "Duboce Triangle Historic Context Statement (2022)",
    "source": "duboce-triangle-context-statement",
    "style": "Danish Gothic",
    "note": "The first church built in Duboce Triangle, City Landmark No. 39, and one of two city landmarks inside the survey area with the Benedict-Gieling House. Brick, with Gothic arch windows, corbelled brickwork and a Danish-style conical steeple; the exterior has remained essentially unchanged. Neither the original architect nor the builder is known. Christopher VerPlanck's context statement of 2022 surveyed 552 properties in Duboce Triangle for the Duboce Triangle Neighborhood Association. The 2017 Eureka Valley context statement names it among the Swedish, Danish and Norwegian institutions of Upper Market Street, near but outside its own study area."
  },
  "building": {
    "name": "Saint Francis Lutheran Church",
    "former_name": "St. Ansgar Danish Evangelical Lutheran Church"
  },
  "historical_record": [
    {
      "kind": "history",
      "date": "1905",
      "description": "Construction began on a vacant 60-by-120-foot lot for San Francisco's Danish community, whose building fund started with 500 Kroner sent by Queen Louise of Denmark.",
      "source": "duboce-triangle-context-statement"
    },
    {
      "kind": "history",
      "date": "1906",
      "description": "Nearly complete when the earthquake struck, the church came through without much damage and its sanctuary was put straight into use by the Red Cross as a field hospital and a shelter for the injured.",
      "source": "duboce-triangle-context-statement"
    },
    {
      "kind": "history",
      "date": "1965",
      "description": "Renamed Saint Francis Lutheran Church after the congregation merged with the nearby First Finnish (Gethsemene) Lutheran Church of 50 Belcher Street. The statement dates the merger to 1964 in one passage and 1965 in another.",
      "source": "duboce-triangle-context-statement"
    }
  ],
  "hook": "Saint Francis Lutheran Church, City Landmark No. 39; begun in 1905 for San Francisco's Danish community and used by the Red Cross as a field hospital after the earthquake."
