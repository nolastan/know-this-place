 "historical_record": [
  {
   "date": "1985",
   "kind": "institution",
   "description": "The archbishop appointed an AIDS minister and the Most Holy Redeemer convent was converted into an AIDS hospice. The Coming Home Hospice here was reportedly the first AIDS hospice in the United States.",
