  },
  {
   "date": "2025-04-02",
   "kind": "designation",
   "summary": "Named a landmark candidate",
   "description": "Put forward as a candidate for individual landmark designation at a District 8 community forum held by the district supervisor and San Francisco Planning, one of twenty-one buildings on the list.",
   "source": "corbett-heights-neighbors"
  },
  {
   "date": "1925-06-13",
   "kind": "construction",
   "description": "A permit was sought for a two-storey frame residence with a basement, estimated at $22,500. N. W. Mohr was named as architect. The owner was the Roman Catholic Archbishop of San Francisco.",
   "source": "building-engineering-news-1925-06-13-n1064"
  },
  {
   "date": "1987-02-19",
   "kind": "opening",
   "description": "Coming Home, a residential hospice for people with AIDS and other terminal illnesses, opened Feb. 19-22, 1987, in the extensively renovated former convent here., owned by Most Holy Redeemer Church.",
