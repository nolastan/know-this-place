  "historic_survey": {
    "survey": "Eureka Valley Historic Context Statement (2017)",
    "source": "eureka-valley-context-statement",
    "year_built_as_surveyed": "ca. 1909",
    "note": "The study area's one extant lodge/hall/commercial building, and put forward as possibly eligible for the California Register as the neighbourhood's primary venue for civic clubs, social organisations and political gatherings. The statement prints the address as 4144-4150 18th Street in most passages and as 4144-4150 Collingwood Street in one."
  },
  "building": {
    "name": "Collingwood Hall"
  },
  "historical_record": [
    {
      "date": "1909",
      "kind": "meeting",
      "description": "The Eureka Valley Promotion Association began meeting at Collingwood Hall and went on doing so through the middle of the twentieth century. The hall housed the Liberty Dramatic Club and the Eureka Vaudeville Club, the Eureka Valley Promotion Association's fiftieth-anniversary carnival in 1931, Halloween carnivals and costume balls, and dances, political meetings, children's events, religious revivals and film screenings through the 1950s and 1960s.",
      "source": "eureka-valley-context-statement"
    },
    {
      "date": "1960s",
      "kind": "business",
      "description": "The Honey Bucket, one of the earliest gay bars to follow the Missouri Mule, opened here. The building had earlier held the Idono Tavern, described as a one-bar memorial to Franklin Roosevelt and a popular postwar neighbourhood bar; a Toad Hall operating at this address is a 2009 rebranding in homage to the original bar at 482 Castro Street.",
      "source": "eureka-valley-context-statement"
    },
    {
      "date": "1974",
      "kind": "meeting",
      "description": "After a police sweep outside Toad Hall on Labor Day 1974, a forum called Together gathered at Collingwood Hall to organise; Harvey Milk and Scott Smith were among the speakers.",
      "source": "eureka-valley-context-statement"
    }
  ]
