 "historical_record": [
  {
   "date": "1908",
   "kind": "construction",
   "description": "The three-story wood-sided building, with a ground-floor storefront and angled bays above, was built.",
   "source": "article-10-lm329"
  },
  {
   "date": "1974",
   "kind": "business",
   "description": "The Full Moon Coffeehouse opened, collectively owned by a group of lesbian women and the first explicitly women-only establishment in San Francisco. Until it closed in 1977 it served food, hosted poetry readings and organised performances by newly popular women's musicians.",
   "source": "eureka-valley-context-statement"
  },
  {
   "date": "1974",
   "kind": "alteration",
   "description": "Members of the lesbian collective that ran the Full Moon Coffeehouse, with volunteers, renovated the storefront themselves, laying new floors, putting in plumbing and painting the walls.",
   "source": "article-10-lm329"
  },
  {
   "date": "1974",
   "kind": "event",
   "description": "During its 1974–1977 run the coffeehouse doubled as a small bookstore and presented women musicians including Malvina Reynolds, Rosalie Sorrells, Meg Christian, Cris Williamson and Margie Adam.",
   "source": "article-10-lm329"
  },
  {
   "date": "1977",
   "kind": "closure",
   "description": "Having never obtained a cabaret license, the Full Moon Coffeehouse lost its lease after neighbors complained of late-night noise, and closed.",
   "source": "article-10-lm329"
  },
  {
   "date": "2025-04-02",
   "kind": "designation",
   "summary": "Named a landmark candidate",
   "description": "Put forward as a candidate for individual landmark designation at a District 8 community forum held by the district supervisor and San Francisco Planning, one of twenty-one buildings on the list.",
