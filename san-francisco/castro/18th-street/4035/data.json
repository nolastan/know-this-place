  "historical_record": [
    {
      "date": "1994-05-04",
      "kind": "move",
      "description": "The Parsonage, the Episcopal Church's ministry with the gay and lesbian community, moved its weekly workshops to the Metropolitan Community Church's community center at 4035 18th Street from 4 May 1994.",
      "source": "bay-area-reporter-BAR_19940428-n11"
    },
    {
      "date": "1993-05-01",
      "kind": "opening",
      "description": "The Metropolitan Community Church opened a community center at 4035 18th Street on 1 May 1993 with a dedication and a block party. The storefront had been The Living Room, a drop-in center for people with HIV and AIDS, which closed at the end of 1992.",
      "source": "bay-area-reporter-BAR_19930415-n1"
    }
