 "historical_record": [
  {
   "date": "1982",
   "kind": "occupancy",
   "description": "The Kaposi's Sarcoma Research and Education Foundation - later the San Francisco AIDS Foundation - opened here in 1982, the first agency in the city specifically addressing the new disease. Identified as potentially eligible for landmark designation.",
   "source": "lgbtq-context-statement"
  },
  {
   "date": "1983",
   "kind": "organisation",
   "description": "The San Francisco AIDS Foundation, founded by Cleve Jones and first run from folding tables at the corner of 18th and Castro streets, opened its first brick-and-mortar space here.",
   "source": "eureka-valley-context-statement"
  }
 ]
