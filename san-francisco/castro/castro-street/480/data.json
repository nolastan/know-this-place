  "historic_survey": {
    "survey": "Eureka Valley Historic Context Statement (2017)",
    "source": "eureka-valley-context-statement",
    "style": "Stick",
    "address_as_surveyed": "482-490 Castro Street / 482 Castro Street",
    "note": "Illustrated in the statement's survey of Eureka Valley property types and architectural styles. The statement is reconnaissance-level and says inclusion in it is not a judgement on a building's worthiness for preservation. It records it as a commercial building and flats, named in the evaluation framework as possibly eligible for the California Register for its association with the growth of the Castro Street corridor; the city numbers this parcel 480-498 Castro Street."
  },
  "historical_record": [
    {
      "date": "1971",
      "kind": "business",
      "description": "Toad Hall opened, the first gay bar to drop a jukebox for mix tapes and the first to offer a clean, well-decorated space in a hip atmosphere, and is credited with drawing many gay men to the Castro. Its owners made the first appeal to the City Board of Permit Appeals against a denied dance hall permit in 1972, believing the denial discriminatory; the Eureka Valley Merchants Association spoke against the permit and the board denied it. On Labor Day 1974 police attacked gay men outside the bar and beat dozens, jailing fourteen for obstructing a sidewalk. Toad Hall closed in 1978. The A & D Club, a postwar neighbourhood bar, was earlier at this address.",
      "source": "eureka-valley-context-statement"
    },
    {
      "date": "1981",
      "kind": "public health",
      "description": "Bobbi Campbell (1952-1984), the first American to publicly share that he had AIDS, posted photographs of his lesions in the window of the Star Pharmacy here to warn the neighbourhood about what was then called gay cancer. He went on to write a column in the Bay Area Reporter about living with AIDS, to co-found the group that became People with AIDS, and to organise the first AIDS Candlelight March, from Castro Street to Civic Center, in 1983.",
      "source": "eureka-valley-context-statement"
    }
  ]
}
