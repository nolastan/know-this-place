  "historic_survey": {
    "survey": "Eureka Valley Historic Context Statement (2017)",
    "source": "eureka-valley-context-statement",
    "style": "Classical Revival",
    "note": "Named as one of two major bank branches built on Castro Street in the 1920s and put forward as possibly eligible for the California Register both for its association with the development of a full-service commercial district in Eureka Valley and as a distinctive example of a Classical Revival bank building. The statement refers to it by both of the street numbers the city carries on this parcel — 410 Castro Street in most passages, 400 and 400-410 in two captions — and calls it the Bank of Italy branch in one of them. A quotation from the citywide LGBTQ context statement gives 410 Castro Street as the address of the Twin Peaks Tavern, which is Landmark #264 at 401."
  },
