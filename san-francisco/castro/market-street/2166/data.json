  "historical_record": [
    {
      "date": "1988-01",
      "kind": "construction",
      "description": "The space at 2166 Market Street that had been the Balcony bar and then the Academy was being remodeled in January 1988 as Centrium, a store for furniture, lighting and decorative arts of the 1940s to the 1960s.",
      "source": "bay-area-reporter-BAR_19880121-n32"
    },
    {
      "date": "1984-10-09",
      "kind": "closure",
      "description": "The Academy, a sex club here, was one of 14 bathhouses, sex clubs and adult bookstores that the city's Director of Public Health ordered to close by noon on 9 October 1984, declaring them a hazard to public health in the AIDS epidemic. The paper reported that several of the 14 reopened within hours to contest the order.",
