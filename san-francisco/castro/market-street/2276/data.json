  "historical_record": [
    {
      "date": "1932",
      "kind": "business",
      "description": "Finnila's Finnish Baths moved to a single-storey brick building at this corner containing the saunas, several storefronts and a family residence. The bath house had begun about 1910 in the basement of 9 Douglass Street and moved to 4032 17th Street from 1919 to 1932. The building was demolished in 1985, after which the bath house moved to the Sunset District; it closed in 2000.",
      "source": "eureka-valley-context-statement"
