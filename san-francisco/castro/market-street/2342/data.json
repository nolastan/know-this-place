  "historical_record": [
    {
      "kind": "history",
      "date": "1963",
      "description": "The Missouri Mule, a honky-tonk bar at 2348 Market Street, changed hands; the new owner, John Burgoa, reoriented it toward a Gay clientele with a campy singer billed as Vivacious Vivian. It was among the earliest Gay-oriented bars in the Upper Market area, and is now Beaux.",
