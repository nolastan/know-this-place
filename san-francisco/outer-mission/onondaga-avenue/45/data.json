  "historical_record": [
    {
      "date": "1933-04",
      "kind": "opening",
      "description": "The Alemany Health Center began operating, four months before the emergency hospital next door opened.",
      "source": "article-10-lm272"
    },
    {
      "date": "1934",
      "kind": "installation",
      "description": "Bernard Zakheim painted two frescoes on the fireplace chimney in the Health Center's waiting room, 'Community Spirit' above the balcony and 'Growth' (also called 'Birth') below it, funded through the Public Works of Art Project under the State Emergency Relief Administration.",
      "source": "article-10-lm272"
    },
    {
      "date": "1976-02-17",
      "kind": "alteration",
      "description": "By February 1976 the lower half of Zakheim's chimney fresco in the Health Center, 'Growth', had been painted over; the painter protested in a letter to columnist Herb Caen dated 17 February 1976.",
      "source": "article-10-lm272"
    },
    {
      "date": "1992–2011",
      "kind": "occupancy",
      "description": "St. Mary's Hospital ran a senior activities center in the former Health Center from 1992 until the program closed for lack of funding in 2011; the Keystone Vocational Training School was also a tenant in those years.",
      "source": "article-10-lm272"
    },
    {
      "date": "2010",
      "kind": "restoration",
      "description": "The painter's son inspected the 'Community Spirit' fresco and uncovered a small part of the painted-over 'Growth' fresco, the only portion visible today.",
      "source": "article-10-lm272"
    },
    {
      "date": "2012",
      "kind": "event",
      "description": "Garavaglia Architecture was hired by the City's Real Estate Division to study the Zakheim frescoes inside the Health Center.",
      "source": "article-10-lm272"
    }
  ]
