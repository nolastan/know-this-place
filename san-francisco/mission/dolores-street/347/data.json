  "historical_record": [
    {
      "date": "1866",
      "kind": "site history",
      "description": "Sister Aloyese of the Cross established a school for girls opposite Mission Dolores, the first in San Francisco, on land from the 1858 federal grant to the Catholic Church. It superseded part of the Mission rancheria, which survives as an archaeological site.",
      "source": "mission-dolores-context-statement"
    },
    {
      "date": "1906",
      "kind": "fire",
      "description": "Firefighters dynamited the Notre Dame Academy to keep the fire from jumping Dolores Street and reaching the mission.",
      "source": "mission-dolores-context-statement"
    },
    {
      "date": "1907",
      "kind": "building contract",
      "description": "Rebuilt to the design of the San Jose architect Theodore Lenzen, nearly an exact duplicate of the earlier building but more than twice its size, ready for over 500 students by the autumn.",
      "source": "mission-dolores-context-statement"
    },
    {
      "date": "1964-08-12",
      "kind": "photograph",
      "description": "Photographed, showing the Notre Dame Catholic Girls High School.",
      "source": "digitalsf-20086"
    },
    {
      "date": "1988",
      "kind": "occupancy",
      "description": "The historic Notre Dame School building, from a ground-floor office of which CURAS provided health education to LGBTQ Latinos; Project Inform was also listed here from 1988 to 1990.",
      "source": "lgbtq-context-statement"
    }
