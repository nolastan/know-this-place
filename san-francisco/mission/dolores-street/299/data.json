  "historical_record": [
    {
      "date": "1911",
      "kind": "site history",
      "description": "Virginia Fair Vanderbilt gave the Sisters of the Holy Family the money to build a children's day home at the corner of Dolores and 16th Streets; Willis Polk designed the Italianate building.",
      "source": "mission-dolores-context-statement"
    },
    {
      "date": "1911",
      "kind": "construction",
      "description": "The three-storey building on the 16th Street corner was built for the Holy Family Day Home, on a building permit issued to Willis Polk and Company. It was the second of the order's three day homes to be rebuilt after the 1906 earthquake and fire destroyed all of them.",
      "source": "sf-environmental-review-299doloresstreet1119sanf"
    },
    {
      "date": "1924",
      "kind": "alteration",
      "description": "A third floor was added to the north wing, whose lower two floors had gone up with the main building.",
      "source": "sf-environmental-review-299doloresstreet1119sanf"
    },
    {
      "date": "1936",
      "kind": "alteration",
      "description": "An auditorium was added at the back, on the east side of the building.",
      "source": "sf-environmental-review-299doloresstreet1119sanf"
    },
    {
      "date": "1964-08-12",
      "kind": "photograph",
      "description": "Photographed.",
      "source": "digitalsf-37694"
    },
    {
      "date": "1983",
      "kind": "alteration",
      "description": "The 1936 auditorium at the back of the building was demolished.",
      "source": "sf-environmental-review-299doloresstreet1119sanf"
    },
    {
      "date": "1984",
      "kind": "construction",
      "description": "A one-storey stucco building was put up on the site for classrooms and child-care facilities.",
      "source": "sf-environmental-review-299doloresstreet1119sanf"
    },
    {
      "date": "1992",
      "kind": "designation",
      "description": "The State Office of Historic Preservation found the 1911 building eligible for the National Register of Historic Places. It had been rated \"2\" in the city's 1976 architectural survey.",
      "source": "sf-environmental-review-299doloresstreet1119sanf"
    }
  ],
