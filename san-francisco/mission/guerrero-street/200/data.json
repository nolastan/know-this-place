  "historical_record": [
    {
      "date": "1960",
      "kind": "fire",
      "description": "The Building Trades Temple burned and was demolished. A large concrete union hall, it housed some seventeen unions and councils in 1953, among them the San Francisco Building & Construction Trades Council and the Carpenters, Painters, Lathers, Millwrights and Cement Masons locals. The statement places the Building Trades Temple at this address, at Fourteenth and Guerrero, and at Fourteenth and Valencia in three separate passages.",
      "source": "market-octavia-context-statement"
