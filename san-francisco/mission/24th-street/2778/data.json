  "historical_record": [
    {
      "date": "1925",
      "kind": "construction",
      "description": "The two-storey wood-frame commercial building was built in 1925; its architect is unknown.",
      "source": "article-10-lm296"
    },
    {
      "date": "1965",
      "kind": "alteration",
      "description": "The building was heavily remodelled: new windows, a new interior wall, and the original front refaced in a late-20th-century commercial style with gravel-faced concrete panels over brick.",
      "source": "article-10-lm296"
    },
    {
      "date": "1968",
      "kind": "sale",
      "description": "The Sanchez family bought the building, then a doughnut shop, to house their firm's restaurant and tortilla factory.",
      "source": "article-10-lm296"
    },
    {
      "date": "1968",
      "kind": "opening",
      "description": "Casa Sanchez opened here as a restaurant and tortilla factory, the fourth and last San Francisco home of the Mexican food business founded in 1924 and its first in the Mission.",
      "source": "article-10-lm296"
    },
    {
      "date": "1968",
      "kind": "alteration",
      "description": "For the restaurant an interior partition was removed, the stairs moved and the wiring and plumbing upgraded, and the projecting “Casa Sanchez Mexican Food” blade sign with the Jimmy the Cornman logo was put up.",
      "source": "article-10-lm296"
    },
    {
      "date": "1984",
      "kind": "fire",
      "description": "After a fire in the early 1980s, a 100-square-foot section of the roof was repaired and a ventilated skylight added.",
      "source": "article-10-lm296"
    },
    {
      "date": "1991",
      "kind": "installation",
      "description": "The corrugated-metal awning with an open gabled dormer, designed by Cervantes Design Associates, was put up across the front as part of a push to revive lower 24th Street.",
      "source": "article-10-lm296"
    },
    {
      "date": "1992",
      "kind": "restoration",
      "description": "After a second fire, walls, siding and ceilings were patched, two doors replaced and outdoor lighting added, with electrical, plumbing, carpentry and painting work finished in 1992.",
      "source": "article-10-lm296"
    },
    {
      "date": "1993",
      "kind": "alteration",
      "description": "The kitchen was upgraded.",
      "source": "article-10-lm296"
    },
    {
      "date": "1997",
      "kind": "installation",
      "description": "The murals “Far away ground”, a landscape and waterscape, were painted on the rear courtyard walls by an artist known as Cruzin Coyote.",
      "source": "article-10-lm296"
    },
    {
      "date": "1998",
      "kind": "event",
      "description": "The restaurant offered free lunch for life to anyone who got its Jimmy the Cornman logo tattooed; at least 50 people did, and the promotion drew coverage from nearly 100 media outlets.",
      "source": "article-10-lm296"
    },
    {
      "date": "2009",
      "kind": "alteration",
      "description": "The building was reroofed, and again in 2016.",
      "source": "article-10-lm296"
    },
    {
      "date": "2011",
      "kind": "closure",
      "description": "Casa Sanchez restaurant closed; the family’s wholesale food business carried on from Millbrae.",
      "source": "article-10-lm296"
    },
    {
      "date": "2022-02-01",
      "kind": "designation",
      "description": "Designated San Francisco Landmark No. 296, Casa Sanchez.",
      "source": "article-10-lm296"
    }
  ],
  "city_landmark": {
    "name": "Casa Sanchez",
    "number": 296,
    "source": "article-10-lm296"
  },
  "notable_residents": [
    {
      "name": "Robert Sanchez Jr.",
      "period": "1968–2003",
      "detail": "Robert Sanchez Jr., son of the company’s founders, ran the restaurant and factory here and devised the Jimmy the Cornman logo; he died in 2003.",
      "source": "article-10-lm296"
    },
    {
      "name": "Martha Sanchez",
      "period": "1968–2011",
      "detail": "Martha Sanchez, called the “Matriarch of the Mission”, ran the restaurant, created its best-selling salsa here and grew the wholesale business; she died in 2011.",
      "source": "article-10-lm296"
    }
  ],
  "building": {
    "architect": "Cervantes Design Associates (awning)",
