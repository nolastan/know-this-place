  "historical_record": [
    {
      "date": "1904",
      "kind": "construction",
      "description": "The two-story-over-ground-floor wood-frame flats building was built around 1904; city water service was tapped on July 10, 1904.",
      "source": "article-10-lm312"
    },
    {
      "date": "2008-03-27",
      "kind": "event",
      "description": "A 2008 historic-resource evaluation of the South Mission rated the building ineligible for the California Register; the mural did not yet exist.",
      "source": "article-10-lm312"
    },
    {
      "date": "2015",
      "kind": "credit",
      "description": "Carlos \"Kookie\" Gonzalez led the painting of the 22-by-28-foot mural La Rumba No Para on the building's west wall, working with artists of the Precita Eyes \"Walls of Respect\" Youth Mural Project.",
      "source": "article-10-lm312"
    },
    {
      "date": "2015",
      "kind": "event",
      "description": "The mural honors Micaela \"Chata\" Gutierrez, KPOO's first Latina DJ, who hosted the Latin music program Con Clave for more than 40 years, and surrounds her with Plena and Rumba dancers and conga players of the Dolores Park scene.",
      "source": "article-10-lm312"
    },
    {
      "date": "2015",
      "kind": "event",
      "description": "Community fundraisers and the California Arts Council paid for the mural, whose design grew from a 2009 poster made for a benefit campaign during Gutierrez's illness.",
      "source": "article-10-lm312"
    },
    {
      "date": "2015-10-15",
      "kind": "opening",
      "description": "The mural was dedicated.",
      "source": "article-10-lm312"
    },
    {
      "date": "2024-01-09",
      "kind": "designation",
      "description": "Designated San Francisco Landmark No. 312, Chata Gutierrez Mural (La Rumba No Para), covering the mural on the west side wall.",
      "source": "article-10-lm312"
    }
  ],
