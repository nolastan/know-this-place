  "historical_record": [
    {
      "date": "1887",
      "kind": "site history",
      "description": "The 1887 Sanborn map shows this block, then cut through by Juniper Street, built up with dwellings of various sizes, stables, a coal and wood yard and the Milwaukee Brewery. It stayed much the same until 1906. The brewery was rebuilt on part of the site, and the 1913 Sanborn map, updated to 1929, shows dwellings, storage and offices, a motor garage and assorted industry. All of it had gone by 1991, when the block was a parking lot and a police vehicle pound.",
      "source": "sf-environmental-review-costcowholesaled1219sanf"
