  "notable_residents": [
    {
      "name": "Frank M. Stone",
      "period": "1886–1906",
      "detail": "Frank M. Stone, a lawyer who came to California in 1874 after years at sea as a supercargo, partner from 1882 to 1887 of the former senator A. A. Sargent and known for the probate law settled in the thirty-year William H. Moore estate case, lived here until shortly after the 1906 earthquake.",
      "source": "article-10-lm074"
    },
    {
      "name": "William Larkins",
      "period": "1906–1915",
      "detail": "William Larkins of Larkins & Co., carriage builders in the city since 1865 who went on to build automobile bodies, bought the house shortly after the 1906 earthquake and lived here until his death in 1915.",
      "source": "article-10-lm074"
    }
