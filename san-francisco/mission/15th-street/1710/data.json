  "historical_record": [
    {
      "date": "1943",
      "kind": "building contract",
      "description": "Valencia Gardens was designed in 1941 by William Wurster and Harry Thomsen for the San Francisco Housing Authority and finished in the late spring of 1943 under the federal slum-clearance programme: twenty-two linked three-storey buildings laid out in a serpentine court plan, turned inward around sheltered courtyards. Thomas Church designed the gardens, and eight Works Progress Administration sculptures by Beniamino Bufano stood in the open spaces. It was demolished after 2003.",
      "source": "sf-environmental-review-valenciagardensh2220sanf"
    }
