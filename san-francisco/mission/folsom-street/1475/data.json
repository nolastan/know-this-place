  "historical_record": [
    {
      "date": "1906-04-18",
      "kind": "site history",
      "description": "The brewery's first building here, begun in 1905, was wrecked by the earthquake and fire while still under construction. A fragment survived and was built back into the replacement: the ground storey of the malt house and the arched carriage entrance beside it, distinguished from the rest of the block by their smaller and more heavily ornamented openings.",
      "source": "nrhp-93000284"
    },
    {
      "date": "1912",
      "kind": "construction",
      "description": "The malt house was rebuilt as a narrow brick and steel-frame building of five storeys and a basement, linked to the corner brew house by an arched carriage entrance with a second-storey overpass over the service alley. It was cut down to two storeys about 1950.",
      "source": "nrhp-93000284"
    },
    {
      "date": "1993-04-08",
      "kind": "designation",
      "description": "Listed on the National Register of Historic Places as one of six contributing buildings in the Jackson Brewing Company Historic District, an L-shaped group laid out around the three jobs a brewery does — malting, brewing and bottling — with the malting and brewing ranges parallel either side of a service alley and the bottling house set apart across a yard.",
      "source": "nrhp-93000284"
    }
  ],
  "hook": "The Jackson Brewery's malt house, whose ground storey survived the 1906 fire that wrecked the rest.",
  "building": {
    "name": "Jackson Brewing Company malt house",
    "builder": "Kaufman & Edwards",
    "builder_note": "James T. Ludlow was the constructing engineer for the 1912 brewery.",
    "style": "Romanesque Revival",
    "sources": [
      "nrhp-93000284"
    ]
  }
