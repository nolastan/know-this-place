  "historical_record": [
    {
      "date": "1912",
      "kind": "construction",
      "description": "The malt kiln building stands south of the malt house on the same footprint line, reached from the service alley: a brick and steel-frame range in three parts — a four-storey kiln, a single-storey engine house whose chimney stack has since gone, and a single-storey addition of about 1913 to 1919.",
      "source": "nrhp-93000284"
    },
    {
      "date": "1993-04-08",
      "kind": "designation",
      "description": "Listed on the National Register of Historic Places as one of six contributing buildings in the Jackson Brewing Company Historic District, an L-shaped group laid out around the three jobs a brewery does — malting, brewing and bottling — with the malting and brewing ranges parallel either side of a service alley and the bottling house set apart across a yard.",
      "source": "nrhp-93000284"
    }
  ],
  "hook": "The Jackson Brewery's malt kiln and engine house, rebuilt in brick and steel in 1912.",
  "building": {
    "name": "Jackson Brewing Company malt kiln and engine house",
