    {
      "date": "early 1850s",
      "kind": "construction",
      "description": "Built in the early 1850s as an investment on a lot bought by a French sea captain during the Gold Rush, which stayed with his family in France for more than a century. The French wine and liquor house C. Lagauterie moved in from two doors away around 1854–55, when the building was numbered 134–136 Jackson.",
      "source": "article-10-lm025"
    },
    {
      "date": "c. 1864–1902",
      "kind": "occupancy",
      "description": "The wine and liquor importers Pascal, Dubedat & Co. occupied the building from about 1864 until 1902; the Sevin-Vincent Seed Company followed from the 1930s to 1954.",
      "source": "article-10-lm025"
    }
