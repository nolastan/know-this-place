  "historical_record": [
    {
      "date": "1967-07-21",
      "kind": "occupancy",
      "description": "The Chinese World, then in its 77th year, was published from this building, which a Chinese association owned. In July 1967 a dispute on its board stopped the press for a day, the first day the paper had missed.",
      "source": "east-west-journal-1967-07-21-p2"
    },
    {
      "date": "1970-02-25",
      "kind": "sale",
      "description": "The Chinese World, a daily that had stopped publishing in September 1969, was sold at auction for $42,000, including its printing plant and a one-quarter interest in this building. Its offices here had already been turned into a curio shop for tourists.",
      "source": "east-west-journal-1970-02-25-p5"
    },
    {
      "date": "1979-05-23",
      "kind": "opening",
      "description": "The National Chinese Welfare Council opened a staffed San Francisco office on the second floor here.",
