    },
    {
      "date": "1913",
      "kind": "occupancy",
      "description": "Vitalini Fotografia Italiana occupied the upper floor here, one of at least six Italian-owned studios on the 1913 Sanborn map.",
      "source": "north-beach-context-statement"
    },
    {
      "date": "1953",
      "kind": "occupancy",
      "description": "City Lights Bookstore, founded by Lawrence Ferlinghetti and Peter D. Martin as the nation's first all-paperback bookstore opened here in 1953; the city's survey names it among the places of the North Beach Beat scene.",
      "source": "north-beach-context-statement"
    },
    {
      "date": "1982",
