  "historical_record": [
    {
      "date": "1907",
      "kind": "construction",
      "description": "A stuccoed brick commercial building, later the home of City Lights Bookstore; the city's survey names Oliver Everett as its architect.",
      "source": "north-beach-context-statement"
    },
    {
      "date": "1913",
      "kind": "occupancy",
      "description": "Vitalini Fotografia Italiana occupied the upper floor here, one of at least six Italian-owned studios on the 1913 Sanborn map.",
      "source": "north-beach-context-statement"
    },
    {
      "date": "1950s",
      "kind": "photograph",
      "description": "Photographed, showing the City Lights Bookstore.",
      "source": "digitalsf-41028"
    },
    {
      "date": "1953",
      "kind": "occupancy",
      "description": "City Lights Bookstore, founded by Lawrence Ferlinghetti and Peter D. Martin as the nation's first all-paperback bookstore opened here in 1953; the city's survey names it among the places of the North Beach Beat scene.",
      "source": "north-beach-context-statement"
    },
    {
      "date": "1956",
      "kind": "occupancy",
      "description": "City Lights Bookstore, whose press published Howl in 1956, leading to a California obscenity trial that the publisher won.",
      "source": "lgbtq-context-statement"
    },
    {
      "date": "1966-11",
      "kind": "site history",
      "description": "Staff at City Lights Books were arrested here in November 1966 for knowingly possessing obscene matter with intent to sell, over a collection of love poems. The case became what has been described as the longest municipal court trial in the city's history, a decade after the Howl prosecution.",
      "source": "counterculture-context-statement"
    },
    {
      "date": "1982",
      "kind": "survey",
      "description": "Recorded in the city's 1982 survey of North Beach, adopted by the Board of Supervisors in 1999, as an individually listed resource. San Francisco City Landmark No. 228.",
      "source": "north-beach-context-statement"
    },
    {
      "date": "2018",
      "kind": "designation",
      "description": "Listed as San Francisco City Landmark No. 228 — City Lights Bookstore.",
      "source": "north-beach-context-statement"
    }
