  "hook": "Ingleside Presbyterian Church, designed by developer Joseph Leonard after a 1920 fire destroyed its predecessor.",
  "historical_record": [
    {
      "date": "1910",
      "kind": "building contract",
      "description": "A Sunday school for 1906 earthquake refugees, begun in 1907 in the basement of the nearby Robinson Apartments, moved into the first purpose-built Presbyterian church on this site in 1910 (not extant).",
      "source": "omi-context-statement"
    },
    {
      "date": "1920",
      "kind": "fire",
      "description": "The 1910 wood-framed Presbyterian church on this site burned down in 1920.",
      "source": "omi-context-statement"
    },
    {
      "date": "1921",
      "kind": "building contract",
      "description": "Ingleside Terraces developer Joseph Leonard donated the land and designed the replacement church, built as a place for various Protestant faiths to worship. The context statement's narrative text dates the building to 1921; a photo caption in the same document dates it to 1923. Both readings are recorded here.",
      "source": "omi-context-statement"
    }
