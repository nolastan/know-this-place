  "historical_record": [
    {
      "date": "1959",
      "kind": "building contract",
      "description": "A State of California office building went up here in 1959. Its facade and interior were damaged in the 1989 Loma Prieta earthquake, after which the State chose not to repair it and it stood vacant. It was cleared for the City Administrative Building.",
      "source": "sf-environmental-review-525goldengateave2320sanf"
    },
    {
      "date": "1887",
      "kind": "site history",
      "description": "The 1887 Sanborn map shows most of the block filled with eight row houses or duplexes set slightly back from the street, with shops along Locust Street — now Redwood Street — and at the McAllister and Polk corner. The block now carries the City Administrative Building.",
      "source": "sf-environmental-review-525goldengateave2320sanf"
    }
