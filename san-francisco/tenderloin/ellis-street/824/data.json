  "historical_record": [
    {
      "date": "1920",
      "kind": "construction",
      "description": "Recorded in the city's survey of the Van Ness Avenue automobile corridor as built for use as an auto repair shop. Built by William Helbing. Reinforced concrete, with restrained ornament on a three-bay front and its original steel sash. Two or three businesses at a time held the building: auto repair shops 1920–1936, auto body and tops and trimming shops 1920–1929, a piston-ring shop 1927–1929, an auto painting and bodywork shop 1938–1940, a used-car wholesaler 1938–1964 and a body and fender shop 1946–1964.",
      "source": "van-ness-auto-row-context-statement"
    },
