  "historical_record": [
    {
      "date": "1925",
      "kind": "construction",
      "description": "One of a row of contiguous flats buildings built in 1925 by Sbarboro, Detjen & Jorgensen, who advertised themselves as the “Pioneer Builders of the Marina District” and had put up a hundred and fifty buildings in it by 1929. No member of the firm was a licensed architect; they designed their own buildings and worked with architects including John Ahnden, Reuben Irvine and Laurence Ebbets.",
      "source": "ppie-marina-context-statement"
    }
