  "historical_record": [
    {
      "date": "1973-05-03",
      "kind": "planning decision",
      "description": "The 6,600-square-foot C-2 corner lot, 60 feet on Fillmore Street by 110 feet on Lombard Street, was then occupied by a Texaco service station, from which an automobile rental agency had also been operating. The City Planning Commission unanimously approved, by Resolution No. 7011 with seven conditions, automobile rentals on the service station lot then on the corner, legalizing a rental agency that had operated there without authorization for about a year.",
