  "historical_record": [
    {
      "date": "1892",
      "kind": "construction",
      "description": "The western half of the Williams-Polk double house by Polk & Polk, built for the painter Dora Norton Williams, who paid Willis Polk's family for it with half the building and lot.",
      "source": "nrhp-87002289"
    },
    {
      "date": "1915",
      "kind": "event",
      "description": "Laura Ingalls Wilder stayed here with her daughter, the Bulletin reporter Rose Wilder Lane, during the Panama-Pacific Exposition, and wrote home about the flat and its view of the bay in the letters later published as West From Home.",
      "source": "nrhp-87002289"
    }
  ],
  "building": {
    "architect": "Polk & Polk",
    "sources": [
      "nrhp-87002289"
    ],
    "completed_conflict": "Recorded as built 1892; the assessor's roll gives 1900."
  },
  "notable_residents": [
    {
      "name": "Dora Norton Williams",
      "period": "1892–c. 1908",
      "detail": "The painter Dora Norton Williams (1829–1915), widow of Virgil Williams and a close friend of Robert Louis Stevenson and Fanny Osbourne, lived here from 1892 until about 1908.",
      "source": "nrhp-87002289"
    },
    {
      "name": "Edward L. Holmes",
      "period": "1900–1904",
      "detail": "The architect Edward L. Holmes, partner of the later City Architect Newton J. Tharp, rented here from 1900 to 1904.",
      "source": "nrhp-87002289"
    },
    {
      "name": "Rose Wilder Lane",
      "period": "c. 1915–1916",
      "detail": "Rose Wilder Lane, then a reporter for the San Francisco Bulletin, rented here about 1915–1916; her mother Laura Ingalls Wilder stayed with her during the 1915 Exposition, and wrote home about the flat in the letters later published as West From Home.",
      "source": "nrhp-87002289"
    }
  ]
