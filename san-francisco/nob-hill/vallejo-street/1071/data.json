  "historical_record": [
    {
      "date": "1912",
      "kind": "construction",
      "description": "Pueblo Revival house, the most purely Pueblo on the hilltop, designed by Charles F. Whittlesey — his first for the Livermore family.",
      "source": "nrhp-87002289"
    },
    {
      "date": "1920",
      "kind": "sale",
      "description": "Bought by Isabel Stine, one of the co-founders of the San Francisco Opera, who owned it through the 1920s and 1930s.",
      "source": "nrhp-87002289"
    },
    {
      "date": "1947",
      "kind": "alteration",
      "description": "Restuccoed, losing the original rough pebble-dash finish, some window boxes and an arch at the patio entrance.",
      "source": "nrhp-87002289"
    },
    {
      "date": "1895–1897",
      "kind": "site history",
      "description": "The humorist Gelett Burgess, author of \"The Purple Cow\" and the Goops, lived in a tiny shack on this site, then numbered 1031 Vallejo Street.",
      "source": "nrhp-87002289"
    }
  ],
