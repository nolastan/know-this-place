  "historical_record": [
    {
      "date": "1853",
      "kind": "site history",
      "description": "What stands here is half of a house of 1853 — the architect William Ranlett's own, one of the first three on Russian Hill, known as the House of Many Corners for the stepped setbacks that left only a third of its bulk against the street. In the 1890s it was divided in two and the northern half moved away; the southern half remained, and a new facade was added in 1975.",
