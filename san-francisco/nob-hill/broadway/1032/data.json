  "historical_record": [
    {
      "date": "1853",
      "kind": "construction",
      "description": "Italianate house, probably built by Joseph M. Atkinson — the oldest and most intact of the three houses on the hilltop that predate the Civil War; its west wing followed a few years later. San Francisco Landmark No. 97.",
      "source": "nrhp-87002289"
    },
    {
      "date": "c. 1893",
      "kind": "alteration",
      "description": "Polk & Polk remodelled the house, and Willis Polk's woodwork survives on the entry floor.",
      "source": "nrhp-87002289"
    },
    {
      "date": "1894",
      "kind": "landscape",
      "description": "Bruce Porter designed the garden, whose walled, overgrown informality set the pattern for the rest of the hilltop.",
      "source": "nrhp-87002289"
    },
    {
      "date": "1890s",
      "kind": "site history",
      "description": "Catherine Atkinson made the house a meeting place for young artists and writers — her cousin Gelett Burgess, Bruce Porter, Willis Polk and the rest of Les Jeunes, the circle that produced the little magazine The Lark.",
      "source": "nrhp-87002289"
    }
  ],
