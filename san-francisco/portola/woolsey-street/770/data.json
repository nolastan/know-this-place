  "historical_record": [
    {
      "date": "1921-03-15",
      "kind": "site history",
      "description": "The block, until then part of a dairy farm, was bought by the Garibaldi brothers, Italian immigrants, who founded the Garibaldi Brothers Nursery here; their first greenhouses went up by 1925, probably in 1922. Its greenhouses are the last commercial ones left in the University Mound flower-growing district, once called the city's Garden District; the nursery closed in the 1990s.",
      "source": "habs-haer-ca4448"
    },
    {
      "date": "1951",
      "kind": "construction",
      "description": "Three greenhouses at the north end of the Bowdoin Street side were built to designs by the architect Robert Nordin.",
      "source": "habs-haer-ca4448"
    }
  ]
