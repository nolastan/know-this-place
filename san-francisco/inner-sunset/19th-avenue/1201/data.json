    {
      "date": "1976-08-05",
      "kind": "occupancy",
      "description": "A gasoline service station, the use of the corner before the present building, occupied the 14,000-square-foot lot as a nonconforming use due to end on 25 November 1983.",
      "source": "sf-planning-commission-minutes-1976-08-05"
    },
    {
      "date": "1976-08-05",
      "kind": "planning decision",
      "description": "The City Planning Commission voted 5-1 to let a two-storey restaurant and cocktail lounge, with 35 parking spaces under the building, replace the gasoline service station on the corner (Resolution 7534).",
      "source": "sf-planning-commission-minutes-1976-08-05"
    },
    {
      "date": "1979-12-13",
      "kind": "planning decision",
      "description": "The City Planning Commission unanimously reaffirmed its earlier authorization (Resolution 7534) of a restaurant with a cocktail lounge and bar in the building then under construction on the corner, on nineteen conditions including at most 178 seats and 85 bar seats, closing by midnight on weekdays and 2 a.m. at weekends, and no cabaret or dancing (Resolution 8448).",
      "source": "sf-planning-commission-minutes-1979-12-13"
