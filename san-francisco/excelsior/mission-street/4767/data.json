  "historical_record": [
    {
      "date": "1935-02-25",
      "kind": "construction",
      "description": "Excelsior real estate broker Ambrose B. Frank (1882–1964) applied as owner for the permit to build this reinforced-concrete commercial building on 25 February 1935, naming no architect; the work was listed as day work at an estimated $9,900.",
      "source": "article-10-lm290"
    },
    {
      "date": "1935-06",
      "kind": "occupancy",
      "description": "By June 1935 half of the building's 10,800 square feet, the rear section on the east side of the lot, was leased to Gaetano Ferrigno for the Sorrento Macaroni factory, which he founded after leaving the Golden Grain macaroni company; its storefront was 4769 Mission and its alley garage entrance 4767.",
      "source": "article-10-lm290"
    },
    {
      "date": "1935-10-17",
      "kind": "installation",
      "description": "A permit was sought on 17 October 1935 to install two large double-brick Dutch ovens for the Royal Baking Company, which had leased the space inside the el of the macaroni factory (approved 27 January 1936).",
      "source": "article-10-lm290"
    },
    {
      "date": "1935-11",
      "kind": "opening",
      "description": "The Royal Baking Company, an Italian bakery previously at 1503 Grant Avenue and 704 Filbert Street in North Beach, applied for its sign permit in November 1935 and moved its business here, selling from the 4773 Mission storefront and supplying bread to restaurants across San Francisco and Daly City.",
      "source": "article-10-lm290"
    },
    {
      "date": "1983",
      "kind": "alteration",
      "description": "Three of the 4773 Mission storefront openings were infilled with glass block and new Spectra-Glaze ceramic tile, alongside new stucco, window and door rehabilitation, and seismic bracing and foundation anchorage.",
      "source": "article-10-lm290"
    },
    {
      "date": "2007",
      "kind": "installation",
      "description": "Benedicto Brigada painted the façade murals, pastoral bread-making scenes and the Last Supper, in the parapet recesses and across the glass-block infill of the ground-floor openings.",
      "source": "article-10-lm290"
    },
    {
      "date": "2020-12-15",
      "kind": "designation",
      "description": "Designated San Francisco Landmark No. 290, Royal Baking Company.",
      "source": "article-10-lm290"
    }
  ],
