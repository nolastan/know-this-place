 "historical_record": [
  {
   "date": "1908",
   "kind": "construction",
   "description": "The Adams Building went up to the design of Washington J. Miller — four storeys and a mezzanine, of masonry and steel with a wood-framed interior, clad in white matte terra cotta and detailed in glazed terra cotta, with Gothic-inspired ornament, large square windows and a hanging cornice. It was characteristic of the retail buildings of its moment. Its decorative corner canopy had since been removed and its mezzanine windows altered.",
   "source": "sf-environmental-review-222kearnystreetd1119sanf"
  },
  {
   "date": "1979",
   "kind": "designation",
   "description": "The Foundation for San Francisco's Architectural Heritage rated the building here \"A\" in the 1979 downtown survey it published as Splendid Survivors — the top of its four grades, which it reserved for the buildings it judged individually most important downtown. The Department of City Planning's 1976 Architectural Inventory coded it 3-F1-3.",
   "source": "sf-environmental-review-333bushstreetdra1198envi"
  },
  {
   "date": "1982-10-06",
   "kind": "designation",
   "description": "The Adams Building was named as one of six buildings in the Hallidie Building Block - Retail Historic District, which the Landmarks Preservation Advisory Board recommended to the City Planning Commission for designation as a city historic district. The district was centred on the Hallidie Building at 130 Sutter Street and covered that side of the block; it also lay within the larger Retail-Shopping Historic District that Heritage had identified as eligible for the National Register.",
   "source": "sf-environmental-review-222kearnystreetd1119sanf"
  }
 ]
