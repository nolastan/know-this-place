  "historical_record": [
    {
      "date": "1973-05-03",
      "kind": "planning decision",
      "description": "The City Planning Commission certified, by Resolution No. 7014, the environmental impact report for a parking and commercial building at the northwest corner of Kearny and Pine Streets, finding no significant effect; one commissioner with an interest in an adjacent parcel abstained. The City Planning Commission unanimously approved, by Resolution No. 7015 with conditions, a five-storey-and-basement garage of about 210 attendant spaces over ground-floor commercial space, topped by a landscaped park extending St. Mary's Square; one commissioner did not take part.",
      "source": "sf-planning-commission-minutes-1973-05-03"
