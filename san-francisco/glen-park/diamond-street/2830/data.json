  "historic_survey": {
    "survey": "Glen Park Historic Resources Evaluation (adopted 2011)",
    "source": "glen-park-context-statement",
    "finding": "Not eligible for the National Register, the California Register or City Landmark designation",
    "style": "Early 20th-century revival, mainly Classical Revival",
    "physical_integrity": "Retains design, workmanship, materials, feeling, association, location and setting",
    "note": "One of eight parcels the evaluation surveyed intensively, and one of five buildings the proposed Diamond/Bosworth infill site would demolish. The Mission Building Company, of 612 Bosworth Street, built it in 1925. Three storefronts at the ground story; canted bays on the outer bays above, paired windows between. The evaluation examined the commercial core at Diamond and Chenery as a potential historic district and found it did not qualify; the city's current record puts this parcel in the California Register-eligible Glen Park Center Historic District."
  },
