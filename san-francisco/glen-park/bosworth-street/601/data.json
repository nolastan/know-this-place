  "historic_survey": {
    "survey": "Glen Park Historic Resources Evaluation (adopted 2011)",
    "source": "glen-park-context-statement",
    "finding": "Appears eligible for the California Register under Criterion 3 (architecture)",
    "style": "Classical Revival",
    "note": "The finding is the San Francisco Planning Department's, from its own survey of the parcels west of Lippard Avenue and inside the neighborhood commercial zoning, which this evaluation reprints. Named with 645 Bosworth Avenue as an example of the two-story Classical Revival residential-over-commercial buildings on Glen Park's commercial corridors: horizontal wood cladding, a cornice with dentils or modillions, an altered ground-floor storefront, and canted or box bays above."
