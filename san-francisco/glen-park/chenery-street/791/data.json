  "historic_survey": {
    "survey": "Glen Park Historic Resources Evaluation (adopted 2011)",
    "source": "glen-park-context-statement",
    "style": "Craftsman",
    "address_as_surveyed": "763–791 Chenery Street",
    "note": "One of the row of Craftsman houses built in 1921 and 1922 along the south side of Chenery Street between Lippard Avenue and Brompton Avenue — gabled roofs with exposed rafter tails and prominent brackets, wide eave overhangs, and double-hung windows with multi-light upper sashes. The evaluation calls the row five houses; the printed range 763–791 covers six parcels on the assessor's roll. Recorded in the reconnaissance survey of 110 parcels but not evaluated individually; buildings the evaluation did not evaluate are treated as potential historical resources pending further project-level study."
  }
