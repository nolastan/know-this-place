    {
      "date": "1908",
      "kind": "construction",
      "description": "The White House department store, designed by architect Albert Pissis.",
      "source": "architecture-preservation-professionals-biographies"
    },
    {
      "date": "1979",
      "kind": "designation",
      "description": "The Foundation for San Francisco's Architectural Heritage rated The White House \"A\" in the 1979 downtown survey it published as Splendid Survivors — the top of its four grades, which it reserved for the buildings it judged individually most important downtown. The Department of City Planning's 1976 Architectural Inventory rated it \"4\" on a scale running from 0 to 5. Buildings rated A or B by the Foundation, or 3 or above by the city survey, went onto the List of Architecturally and/or Historically Significant Buildings in the Downtown, adopted by the City Planning Commission on 29 May 1980 in Resolution No. 8600.",
      "source": "sf-environmental-review-222kearnystreetd1119sanf"
