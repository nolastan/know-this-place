  "historical_record": [
    {
      "date": "1979",
      "kind": "designation",
      "description": "The Foundation for San Francisco's Architectural Heritage rated the building here \"C\" in the 1979 downtown survey it published as Splendid Survivors — the third of its four grades, for buildings that count for their scale and materials and for the way they hold a streetfront together. The Department of City Planning's 1976 Architectural Inventory did not rate it.",
      "source": "sf-environmental-review-333bushstreetdra1198envi"
    },
    {
      "date": "1982-10-06",
      "kind": "designation",
      "description": "The building here was named as one of six buildings in the Hallidie Building Block - Retail Historic District, which the Landmarks Preservation Advisory Board recommended to the City Planning Commission for designation as a city historic district. The district was centred on the Hallidie Building at 130 Sutter Street and covered that side of the block; it also lay within the larger Retail-Shopping Historic District that Heritage had identified as eligible for the National Register.",
      "source": "sf-environmental-review-222kearnystreetd1119sanf"
