  "historical_record": [
    {
      "date": "1920",
      "kind": "construction",
      "description": "The building went up as the Balfour Building to the design of George Kelham — a two-part vertical composition with a dark textured brick facade over a carved limestone base, restrained Renaissance and Baroque ornament outside and in its vaulted ground-floor elevator lobby, on a steel frame. It shortly became part of the Dollar Lines group of buildings and was renamed the J. Harold Dollar Building. The Foundation for San Francisco's Architectural Heritage rated it \"B\".",
      "source": "sf-environmental-review-333californiaoff5198sanf"
