  "historical_record": [
    {
      "date": "1960-05",
      "kind": "site history",
      "description": "In May 1960 the City Planning Commission approved a restaurant in the building, stipulating no exterior alterations other than two new entrances and identification only by a small bronze plaque.",
      "source": "sf-planning-commission-minutes-1974-01-10"
    },
    {
      "date": "1974-01-10",
      "kind": "occupancy",
      "description": "The 4,650-square-foot corner lot (77.5 feet on California, 60 feet on Mason) held a seven-storey reinforced concrete building with 12 apartments and Alexis' Restaurant, a non-conforming use not subject to expiration; windows on its east wall had been closed up.",
      "source": "sf-planning-commission-minutes-1974-01-10"
    },
    {
      "date": "1974-01-10",
      "kind": "planning decision",
      "description": "The City Planning Commission unanimously refused to modify its 1960 stipulations to allow a three-panel mural incorporating a sign for Alexis' Restaurant on the building's Mason Street wall.",
      "source": "sf-planning-commission-minutes-1974-01-10"
    },
