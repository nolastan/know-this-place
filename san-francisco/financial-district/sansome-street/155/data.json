  "historical_record": [
    {
      "kind": "construction",
      "description": "Michael Goodman took part in the design of the Stock Exchange Luncheon Club, now the City Club, and recommended Diego Rivera as the building's muralist.",
      "source": "architecture-preservation-professionals-biographies"
    },
    {
      "date": "1930",
      "kind": "construction",
      "description": "Miller and Pflueger built the office tower here alongside their conversion of the old U.S. Treasury building into the Pacific Coast Stock Exchange — a traditional three-part vertical composition with a giant order at the capital, its limited ornament a blend of classical and Moderne focused in a sculptural group over the door.",
      "source": "sf-environmental-review-333californiaoff5198sanf"
    }
