  "historical_record": [
    {
      "date": "1927",
      "kind": "building contract",
      "description": "The Financial Center Building stands on the northwest corner of California and Montgomery Streets, seventeen storeys on an L-shaped plan. Polished granite was applied to its first four floors in 1956, covering the original 1927 front with its arched doorway and arched windows. The building stood empty from 1990 until a 1998 project converted it into a hotel of about 362 rooms and restored the lower facade to something like its first appearance.",
