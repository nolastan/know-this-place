  "historical_record": [
    {
      "date": "1915",
      "kind": "construction",
      "description": "The building went up as the U.S. Treasury — an enframed pavilion with end bays, an attic and a base, fronted by a Doric colonnade.",
      "source": "sf-environmental-review-333californiaoff5198sanf"
    },
    {
      "date": "1930",
      "kind": "alteration",
      "description": "Miller and Pflueger converted the old Treasury into the Pacific Coast Stock Exchange: massive corners were added to the front to terminate the existing Doric colonnade, a massive attic wall was raised above the cornice, the end walls were refenestrated and two colossal sculptural groups by Ralph Stackpole were set on pedestals in front of the building. The interior was left as a single great hall under a louvered screen below the skylight. The Foundation for San Francisco's Architectural Heritage rated the result \"A\".",
      "source": "sf-environmental-review-333californiaoff5198sanf"
