  "narrative": {
    "sections": [
      {
        "heading": "The General Harrison",
        "body": "The storeship General Harrison was built at Newburyport, Massachusetts in 1840 and ended up buried in the made ground of the waterfront, where excavation for this building uncovered it in 2001. Its hull is now a 60-foot artwork in the sidewalk outside — flattened copper ribs on a stainless steel frame.\nThe published account of the work spells the artist's name both “Topher Delany” and “Topher Delaney”; the city's inventory gives Delaney."
      }
    ]
  },
