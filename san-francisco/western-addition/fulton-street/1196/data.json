  "historical_record": [
    {
      "date": "1928",
      "kind": "occupancy",
      "description": "The Westerfeld House, built in 1889 to a design by Henry Geilfuss as a Stick Italianate villa, was rented by the Russian Club from 1928 to 1937. It held the club's library and was the headquarters of the Consolidated Committee of Russian National Organizations, which worked from here on the 1933 amendment to the Registry Act granting amnesty to Russian immigrants; a film was shot inside it in 1933. Émigrés went on renting rooms in the house into the 1950s.",
      "source": "russian-american-context-statement"
    }
