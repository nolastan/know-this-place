  "historical_record": [
    {
      "date": "1936",
      "kind": "construction",
      "description": "Purpose-built premises for the Japanese YMCA, dedicated in 1936: $25,000 raised within Japantown and about $15,000 given by supporters in Japan paid for meeting rooms, a small chapel and a gymnasium.",
      "source": "japantown-context-statement"
    },
    {
      "date": "1942",
      "kind": "site history",
      "description": "One of the places in the city where San Francisco's Japanese community was ordered to report for processing in 1942 before wartime removal. The building was let to the USO during the war to serve African American troops.",
      "source": "japantown-context-statement"
    },
    {
      "date": "1947",
      "kind": "occupancy",
      "description": "Returned to the Japanese American community after the war and renamed the Buchanan YMCA; in 1947 it and the Japantown YWCA began a joint inter-racial youth programme for African American and Japanese American children.",
      "source": "japantown-context-statement"
    },
    {
      "date": "July 1948",
      "kind": "site history",
      "description": "More than 300 residents met here in July 1948 to hear the case against the Redevelopment Agency's plans for the neighborhood.",
      "source": "japantown-context-statement"
    },
    {
      "date": "1958",
      "kind": "occupancy",
      "description": "The Redevelopment Agency established its Western Addition Project Office in the building in 1958.",
      "source": "japantown-context-statement"
    }
  ],
  "unknowns": [
    "The city's Japantown context statement dates the dedication of the building to 1936; the assessor's roll and Planning's historic resource survey both record 1935."
