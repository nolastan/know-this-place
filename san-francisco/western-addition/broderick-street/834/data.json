 "historical_record": [
  {
   "date": "1970-05-07",
   "kind": "planning decision",
   "description": "A residential building occupied the lot, immediately south of the Florence Crittenton Home. The City Planning Commission approved, with six conditions, converting the residential building into an annex of the Florence Crittenton Home, with offices and interview rooms on the first floor and housing for up to twelve older girls on the second.",
   "source": "sf-planning-commission-minutes-1970-05-07"
  },
  {
   "date": "1971-09-02",
   "kind": "planning decision",
   "description": "The two-storey building housed the offices of the Florence Crittenton Home on its first floor; the second floor, meant for housing unwed mothers, was no longer needed for that. The City Planning Commission approved, with conditions, a youth hostel for up to 17 young adults run by the Travelers Aid Society on the building's second floor, with the Florence Crittenton Home's offices staying on the first floor.",
   "source": "sf-planning-commission-minutes-1971-09-02"
  }
 ]
