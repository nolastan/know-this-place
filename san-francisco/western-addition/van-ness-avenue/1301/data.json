  "historical_record": [
    {
      "date": "1911",
      "kind": "construction",
      "description": "Recorded in the city's survey of the Van Ness Avenue automobile corridor as built for use as an auto showroom. Dated 1911–1912.",
      "source": "van-ness-auto-row-context-statement"
    },
    {
      "date": "1912",
      "kind": "construction",
      "description": "Designed by Cunningham and Politeo in their preferred Art Nouveau manner, for the Goodyear Tire and Rubber Company. A long expanse of prism glass survives on the Fern Street side. The Goodyear Tire and Rubber Company's San Francisco factory branch, 1912–1917, taking half the first storey and all of the second; the rest of the building was divided into small auto showrooms. Goodyear left in 1917 to sell through local dealers instead.",
      "source": "van-ness-auto-row-context-statement"
    },
    {
      "date": "2010",
      "kind": "survey",
      "description": "Evaluated in the city's survey of the Van Ness Avenue automobile corridor and given California Register status code 3CS — individually eligible for the California Register, under Criteria 1 and 3.",
