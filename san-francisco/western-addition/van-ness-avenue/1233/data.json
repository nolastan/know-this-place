  "historical_record": [
    {
      "date": "1913",
      "kind": "construction",
      "description": "Recorded in the city's survey of the Van Ness Avenue automobile corridor as built for use as a tire shops and offices. The survey dates the work to 1913–1914. Designed by David C. Coleman and built as a pair with 1243-1245 Van Ness Avenue. Two of its three storefronts were let to tire companies on completion, with vehicle access for tire fitting off the alley now called Daniel Burnham Court.",
      "source": "van-ness-auto-row-context-statement"
    },
    {
      "date": "1914",
      "kind": "occupancy",
      "description": "Two of the three storefronts went to tire companies: the Tansey-Crowe Company, distributing for the Pennsylvania Rubber Company, for ten years, and the factory branch of the Federal Rubber Manufacturing Company of Milwaukee for eight.",
      "source": "van-ness-auto-row-context-statement"
    },
    {
      "date": "2010",
      "kind": "survey",
      "description": "Evaluated in the city's survey of the Van Ness Avenue automobile corridor and given California Register status code 3CS — individually eligible for the California Register, under Criteria 1 and 3.",
      "source": "van-ness-auto-row-context-statement"
    }
  ]
