  "historical_record": [
    {
      "date": "1966-09-27",
      "kind": "civil disturbance",
      "description": "The first call to police on the night of the Hunters Point uprising came from a store at this address. Crowds had gathered on Third Street after a white police officer shot and killed Matthew Johnson, a 16-year-old who had run from a car reported stolen; the officer said he fired two shots in the air and one at the youth, while witnesses said he fired all three at him. The police imposed a curfew and closed the bars and liquor stores, and later marched down Third Street firing live ammunition over the heads of the protesters, clearing the street from Newcomb to Palou.",
      "source": "bvhp-area-b-context-statement"
    }
