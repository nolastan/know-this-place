  "historical_record": [
    {
      "date": "1883",
      "kind": "designation",
      "description": "Built about 1883 and designated San Francisco Landmark No. 263 as Sam Jordan's Bar, for its association with Sam Jordan — a business, political, social and cultural leader in Bayview through the twentieth century and the city's first African American candidate for mayor. Its projecting metal sign, with neon lettering and a martini glass, dates from the period that made the building significant and is a character-defining feature of it.",
