    },
    {
      "date": "1990-05",
      "kind": "event",
      "description": "A 550-gallon gasoline underground storage tank was removed from the site under the city's Local Oversight Program; soil testing at the removal found gasoline-range petroleum hydrocarbons and BTEX compounds.",
      "source": "sf-environmental-review-491bayshorehomed6200sanf"
    },
    {
      "date": "1999-02",
      "kind": "event",
      "description": "Two 4,000-gallon underground storage tanks were removed from the site; soil and groundwater samples at the excavation found petroleum hydrocarbons, BTEX, MTBE and lead.",
      "source": "sf-environmental-review-491bayshorehomed6200sanf"
    },
    {
      "date": "1999-06",
      "kind": "occupancy",
      "description": "Whole Earth Access, a home furnishing and supply store of about 30,500 square feet, occupied the second building on the site until June 1999.",
