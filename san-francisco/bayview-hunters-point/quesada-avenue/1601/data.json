  "hook": "St. Joan of Arc church and school, built 1922 for the district's French and French-Canadian Catholics.",
  "historical_record": [
    {
      "date": "1922",
      "kind": "construction",
      "description": "Built as St. Joan of Arc Roman Catholic Church and School for the district's French and French-Canadian population, who had worshipped until then at an earlier St. Joan of Arc on La Salle Avenue, put up for the French immigrants working in the meat packing plants and tanneries of Butchertown. In 1949 the congregation built a new church on the opposite side of Lane Street; this building is no longer in use as a church.",
      "source": "bvhp-area-b-context-statement"
    }
