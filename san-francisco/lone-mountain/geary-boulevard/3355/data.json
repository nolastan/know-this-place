  "historical_record": [
    {
      "date": "1963-10",
      "kind": "protest",
      "description": "A mixed group of African American and white demonstrators staged sit-ins at the Mel's Drive-In here from October 1963, led by the Ad Hoc Committee to End Racial Discrimination; after weeks of protest the owners agreed to hire and train African Americans as waitresses, cooks, carhops, cashiers and bartenders. Identified in 2024 as eligible for local landmark, California Register or National Register designation.",
      "source": "african-american-context-statement"
    },
