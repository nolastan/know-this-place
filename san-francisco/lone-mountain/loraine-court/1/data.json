  "building": {
    "architect": "Bernard Joseph Stanislaus Cahill",
    "name": "Independent Order of Odd Fellows Columbarium"
  },
  "historical_record": [
    {
      "date": "1897",
      "kind": "construction",
      "description": "Independent Order of Odd Fellows Columbarium, designed by Bernard Joseph Stanislaus Cahill.",
      "source": "architecture-preservation-professionals-biographies"
    },
    {
      "date": "1996",
      "kind": "designation",
      "description": "Designated San Francisco Landmark No. 209, San Francisco Columbarium (Odd Fellows Columbarium).",
      "source": "article-10-lm209"
    },
    {
      "date": "1898",
      "kind": "construction",
      "description": "Completed for the Odd Fellows Cemetery Association to designs by Bernard J. S. Cahill, a London-born architect remembered as an early planner of the Civic Center: a steel-reinforced Neo-Classical rotunda of cement plaster under a copper dome, with a temple front on each side and an interior of intense colour and faux finishes. Those whose ashes rest here include the painters Arthur and Lucia Mathews, Adolph Sutro, the photographer Gabriel Moulin and A. P. Hotaling.",
      "source": "article-10-lm209"
    },
    {
      "date": "1937",
      "kind": "event",
      "description": "The Board of Supervisors banned burial in the city, and the Lone Mountain cemeteries were moved to Colma; the columbarium and its small garden were allowed to stay, leaving it the city's last burial site. Neglected for decades — water poured down its marble stair in winter, and raccoons and pigeons lived in it — it was saved when the Neptune Society bought it.",
      "source": "article-10-lm209"
    }
  ],
  "city_landmark": {
    "name": "San Francisco Columbarium (Odd Fellows Columbarium)",
    "number": 209,
    "source": "article-10-lm209"
  }
