  "historical_record": [
    {
      "date": "1920s",
      "kind": "site history",
      "description": "One of the prominent Japanese establishments at South Park, alongside the Higoyo Hotel, the Biwako Baths and the Hotel Bo-Chow, in an enclave that formed after 1910 and dispersed to Japantown in the 1930s when the Japanese steamship lines moved to piers north of the Ferry Building.",
      "source": "central-soma-context-statement"
    },
    {
      "date": "1930s",
      "kind": "sale",
      "description": "The former Omiya Hotel was purchased by the Gran Oriente Filipino Masonic Lodge, and served as a meeting place and boarding house for members working in San Francisco and for farm workers from the Central Valley who visited at weekends. It is among the longest-held Filipino-owned cultural assets in San Francisco, and was put forward for San Francisco Landmark designation.",
      "source": "central-soma-context-statement"
    }
  ],
