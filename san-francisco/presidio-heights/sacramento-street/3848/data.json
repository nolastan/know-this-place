  "historical_record": [
    {
      "date": "1907",
      "kind": "construction",
      "description": "The La Hacienda Apartments, designed by the architect Henry C. Smith, who kept a fourteen-room apartment in the building alongside four rented units of five to nine rooms. Smith's name is attached to the hillside apartment type, and his work was profiled in the Architect and Engineer in 1912 and 1916.",
      "source": "large-apartment-context-statement"
    },
    {
      "date": "2024",
      "kind": "survey",
      "description": "Evaluated in the city's citywide survey of large apartment buildings as altered past its historic integrity: a garage added, decorative windows, balconies and planters removed, the landscaping changed and a forward addition built at the top storey, leaving the central courtyard hard to read from the street.",
      "source": "large-apartment-context-statement"
    }
