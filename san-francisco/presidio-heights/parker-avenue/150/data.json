  "historical_record": [
    {
      "date": "1970-11-05",
      "kind": "planning decision",
      "description": "The property held a nursery school with morning and afternoon sessions of 25 children in its rear building, and a kindergarten in the front building, which had formerly been a residence. The City Planning Commission approved, with six conditions, a kindergarten for up to 15 children in the front building of the nursery school, limiting the nursery to 25 children at a time and hours to 8 a.m.-5 p.m.",
