  "historical_record": [
    {
      "date": "1974-09-05",
      "kind": "planning decision",
      "description": "The corner lot at Broadway and Gough held two dilapidated buildings, one vacant and the other condemned by the city; the land was zoned R-4, having been R-5 when plans for a new building were filed in December 1973. The City Planning Commission unanimously certified the environmental impact report for a proposed 43-unit apartment building, finding it would have no significant effect on the environment.",
      "source": "sf-planning-commission-minutes-1974-09-05"
    },
    {
      "date": "1974-09-12",
      "kind": "planning decision",
      "description": "After discretionary review, the City Planning Commission unanimously approved the building permit for a 43-unit apartment building with one parking space per unit, declining to require a side setback to protect windows of the neighbouring building at 1770 Broadway.",
      "source": "sf-planning-commission-minutes-1974-09-12"
    }
