  "historical_record": [
    {
      "date": "1974",
      "kind": "site history",
      "description": "The Nihonmachi Community Development Corporation secured this property in 1974 for the Japanese Cultural and Community Center of Northern California, which had been incorporated the year before.",
      "source": "japantown-context-statement"
    },
    {
      "date": "1986",
      "kind": "construction",
      "description": "The first phase of the centre's Japanese-style building was completed in 1986 to a design by the Nisei architect Wayne Osaki — half-timbered walls, broad gable roofs with exposed rafter tails and gilded ornament — and housed arts and community non-profits alongside the centre's own programmes.",
      "source": "japantown-context-statement"
    }
  ],
  "unknowns": [
