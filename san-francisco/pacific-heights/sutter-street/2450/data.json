  "historical_record": [
    {
      "date": "1911",
      "kind": "construction",
      "description": "Completed in the autumn of 1911 as Turn Verein Hall for the San Francisco Turn Verein, a German gymnastics society, to a design by Emil A. Neumarkel: four floors including a basement, a Baroque façade, a ballroom and a stage. It was renamed Sciots Hall before 1939 as anti-German feeling grew.",
      "source": "russian-american-context-statement"
    },
    {
      "date": "1940-05-18",
      "kind": "occupancy",
      "description": "Bought by the Consolidated Committee of Russian National Organizations for $30,000 and opened as the Russian Center on 18 May 1940 before thousands of people. It has housed Russian community organisations, festivals and performances since; the Museum of Russian Culture opened in it in 1948, the Russkaia zhizn newspaper has had its offices and press here since 1942, and retrofitting after the 1989 Loma Prieta earthquake was funded by community donations.",
      "source": "russian-american-context-statement"
    },
    {
      "date": "1960s",
      "kind": "event",
      "description": "Russian Hall, one of the venues where drag theatre companies mounted productions in the 1960s and 1970s.",
      "source": "lgbtq-context-statement"
    }
  ],
  "unknowns": [
