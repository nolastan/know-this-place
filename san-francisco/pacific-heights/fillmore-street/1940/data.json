  "historical_record": [
    {
      "date": "1882",
      "kind": "construction",
      "description": "The Fillmore-Pine Building, designed by the German architect Wildrich Winterhalter and built at the south-west corner of Pine and Fillmore in 1882 for a tobacco and cigar importer: an early example of a mixed-use building, with two storefronts — one let to a shoe shop, one to a fancy goods shop — and living quarters above.",
      "source": "japantown-context-statement"
    },
    {
      "date": "by 2009",
      "kind": "designation",
      "description": "Listed on the National Register of Historic Places as the Fillmore-Pine Building — one of three National Register sites in the Japantown study area, and the only mixed-use building there so listed. The nomination dates from 1980.",
      "source": "japantown-context-statement"
    }
  ],
