  "historical_record": [
    {
      "date": "1929",
      "kind": "construction",
      "description": "The Morning Star School opened at 1715 Octavia Street, on this parcel, in 1929 for kindergarten to sixth grade, in a blend of Asian and Mission Revival styles, with a multi-purpose auditorium built for staging Japanese plays. The pastor and congregation of St Francis Xavier Mission were involved in building it, and Japanese language classes were held here for pupils of the public schools as well.",
      "source": "japantown-context-statement"
    },
    {
      "date": "1930s–1940s",
      "kind": "occupancy",
      "description": "A convent home stood at 1911 Pine Street, round the corner from the Morning Star School and on what is now the same parcel. It gave lunch to neighborhood schoolchildren who needed it.",
      "source": "japantown-context-statement"
    },
    {
      "date": "2009",
      "kind": "survey",
      "description": "Recorded in the city's 2009 survey of Japantown as the Morning Star School, taken as representative of the neighborhood's school buildings.",
      "source": "japantown-context-statement"
    }
  ]
