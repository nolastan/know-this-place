    {
      "date": "1921",
      "kind": "occupancy",
      "description": "The Mme. C.J. Walker Home for Girls opened here in 1921, run by the Walker Club: lodging and job referrals for African American women new to the city, with a social hall and large kitchen used for community gatherings. It ran until 1972, when it moved to Hayes Street.",
      "source": "japantown-context-statement"
    },
    {
      "date": "June 1999",
      "kind": "designation",
      "description": "Designated a City of San Francisco landmark in June 1999 as the Madame C.J. Walker Home for Girls and Women, and the only designated residence in the Japantown survey area with a recorded tie to the Japanese American community.",
      "source": "japantown-context-statement"
    }
