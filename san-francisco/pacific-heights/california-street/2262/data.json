  "historical_record": [
    {
      "date": "1904",
      "kind": "construction",
      "description": "Congregation Sherith Israel moved from Post and Taylor streets into a new building here in 1904: a grand neoclassical design with a large central dome by the Beaux-Arts-trained architect Albert Pissis, whose other work includes the Hibernia Bank and the Flood Building. Its sanctuary holds a stained-glass window showing Moses carrying the Ten Commandments from El Capitan into Yosemite Valley.",
      "source": "japantown-context-statement"
    },
    {
      "date": "1906",
      "kind": "occupancy",
      "description": "One of the few large buildings left standing after the earthquake and fires of 1906, it served as the city's Hall of Justice while the Civic Center was rebuilt.",
      "source": "japantown-context-statement"
    }
  ]
