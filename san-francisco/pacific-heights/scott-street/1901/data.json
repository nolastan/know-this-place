    {
      "date": "1977",
      "kind": "designation",
      "description": "Designated San Francisco Landmark No. 98, Ortman-Shumate House.",
      "source": "article-10-lm098"
    },
    {
      "date": "1870",
      "kind": "construction",
      "description": "Built in 1870 for the grocer John F. Ortman, who bought the fifty-vara corner lot on 25 February 1870 for $5,000 on the block then known as the Pic-nic Block, where his family used to drive out for picnics. His descendants lived in the house for 107 years and kept its large garden, rare in the city.",
      "source": "article-10-lm098"
    }
  ],
  "notable_residents": [
    {
      "name": "John F. Ortman",
      "period": "1870–1912",
      "detail": "John F. Ortman (1829–1912), a Hanover-born grocer who came to California in 1851, kept a store at Post and Kearny and retired as a capitalist, lived here until his death; most of his property, insured by German companies that refused to pay for 1906, had to be rebuilt at his own cost.",
      "source": "article-10-lm098"
    }
  ],
