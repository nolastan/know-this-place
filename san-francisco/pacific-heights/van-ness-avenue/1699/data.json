  "historical_record": [
    {
      "date": "1919",
      "kind": "construction",
      "description": "Recorded in the city's survey of the Van Ness Avenue automobile corridor as built for use as an auto showroom. Dated 1919 and 1923. Designed by Sylvain Schnaittacher, with a tall ground-floor arcade in an Italian Renaissance manner: the northern three bays in 1919, the southern two added in 1923. It was the showroom for the Paige, later Graham-Paige, motor car.",
      "source": "van-ness-auto-row-context-statement"
    },
    {
      "date": "2010",
      "kind": "survey",
      "description": "Evaluated in the city's survey of the Van Ness Avenue automobile corridor and given California Register status code 1S and 3CS — listed on the National Register and individually eligible for the California Register, under Criteria 1 and 3.",
      "source": "van-ness-auto-row-context-statement"
    }
