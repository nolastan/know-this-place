  "historical_record": [
    {
      "date": "1924",
      "kind": "site history",
      "description": "Built for Grinnell Company of the Pacific, successor to the General Fire Extinguisher Company, and photographed for the March 1935 issue of Architect & Engineer; the UMB survey noted its 'robust red' brick, and it carries roofline plaques bearing the letter G and the image of a fire sprinkler. Added to the Bluxome and Townsend Warehouse Historic District, correcting an apparent omission in the South of Market survey, whose DPR 523 A form gave no year of construction and photographed the company's separate steel-framed pipe shed instead. The same architects designed another contributor to the district, 650 5th Street.",
      "source": "central-soma-context-statement"
    }
