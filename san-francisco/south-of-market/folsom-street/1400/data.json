  "historical_record": [
    {
      "date": "1929",
      "kind": "occupancy",
      "description": "Reported as the first automobile showroom to open in the South of Market, and the works of Kleiber, one of only two firms that built automobiles in San Francisco. Kleiber stopped making cars in 1929 but went on with trucks and diesels until 1937; by the mid-1920s the company had branches from Seattle to Santa Barbara. The exterior windows were covered with a stud wall and stucco in 1985.",
      "source": "sf-environmental-review-27510thstreetsup2200sanf"
