  "historical_record": [
    {
      "date": "1872",
      "kind": "site history",
      "description": "The new St. Patrick's church was dedicated, serving a predominantly Irish immigrant population of about 30,000 and intended as the Irish national church of San Francisco and the West Coast. The parish had been established in 1851 in a rented hall at 4th and Jessie streets, and its lot on the north side of Mission Street was bought after the Civil War.",
      "source": "central-soma-context-statement"
    },
    {
      "date": "1906-04-18",
      "kind": "fire",
      "description": "Heavily damaged in the earthquake and fire; the church was reconstructed.",
      "source": "central-soma-context-statement"
    },
    {
      "date": "1939",
      "kind": "site history",
      "description": "The church rectory adjoining it was constructed.",
      "source": "central-soma-context-statement"
    },
    {
      "date": "1965",
      "kind": "site history",
      "description": "Yerba Buena Center redevelopment plans showed only 15 percent of the roughly 400 buildings in the project area being retained, with the central blocks razed save for St. Patrick's Church.",
      "source": "central-soma-context-statement"
    },
    {
      "date": "1906",
      "kind": "fire",
      "description": "The steeple, which had stood 200 feet above the street, was lost with the rest of the church in the earthquake and fire. The rebuilt church went up in the same Gothic Revival style but without it.",
      "source": "early-settlement-era-styles-context-statement"
    }
  ],
