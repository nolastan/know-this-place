  "narrative": {
    "sections": [
      {
        "heading": "Global Gardens",
        "body": "The site stood vacant from the Loma Prieta earthquake of 1989 until this building. Catherine Wagner's digitally embossed metal panels on the Natoma Street elevator tower show plants particular to the cultures of the surrounding neighbourhood. The city's inventory titles the work “Global Garden” and leaves the artist unnamed."
      }
    ]
  },
