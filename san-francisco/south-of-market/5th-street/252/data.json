  "historical_record": [
    {
      "date": "1899",
      "kind": "site history",
      "description": "The site was first built on in about 1899, and between then and 1923 held stores, a saloon and dwellings. An older commercial building stood on its northern corner until about 1956.",
      "source": "sf-environmental-review-draftenvironment2920pbsj"
    },
    {
      "date": "1923",
      "kind": "construction",
      "description": "A two-storey reinforced concrete warehouse of 1923 by the architects the O'Brien Brothers, with the Meyers Brothers as contractors: a rectangle 275 feet by 75 feet under a flat roof, its long Clementina Street side divided into thirteen symmetrical bays. The blind Tehama Street wall later carried a painted mural of the Golden Gate Bridge. Its offices were long those of Bill Graham Presents.",
      "source": "sf-environmental-review-draftenvironment2920pbsj"
    }
