  "narrative": {
    "sections": [
      {
        "heading": "Caruso's Dream",
        "body": "The thirteen suspended pianos were unveiled on 23 February 2014, built from salvaged safety plate glass forty to sixty years old and Douglas fir milled out of the foundations of the demolished 1939 Transbay Terminal. At night they light in sequence with a recording of Enrico Caruso, who sang at the Grand Opera House the night before the 1906 earthquake and described it afterwards as his bed rocking like a ship at sea."
      }
    ]
  },
