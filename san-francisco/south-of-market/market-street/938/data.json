    {
      "date": "2004",
      "kind": "designation",
      "description": "Designated San Francisco Landmark No. 244: conditionally designated, the designation to become final when the building is rehabilitated.",
      "source": "article-10-lm244"
    },
    {
      "date": "1907–1908",
      "kind": "construction",
      "description": "Built for Elise Abigail Drexler — among the first women in San Francisco to develop property on her own account, who had lost most of her buildings in 1906 — as an L-shaped store and loft building wrapping round the Mechanics' Savings Bank, to designs by the Reid Brothers; she urged the contractor on so that its first tenant, Brittain & Co., sellers of hardware and sporting goods, could move in by October 1. Dentists' offices filled its upper floors for many years.",
      "source": "article-10-lm244"
    },
    {
      "date": "1955",
      "kind": "alteration",
      "description": "The original marble lobby was removed and lined in travertine.",
      "source": "article-10-lm244"
