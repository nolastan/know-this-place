  "historical_record": [
    {
      "date": "1906",
      "kind": "site history",
      "description": "San Francisco Fire Department Engine No. 35 was built here, a 1937 newspaper article quoting the department that the structure was put up in 1906 to serve only until a permanent house could be provided. The station carried a steamer hose wagon, a truck, a monitor battery and a hose tower.",
      "source": "central-soma-context-statement"
    },
    {
      "date": "1937",
      "kind": "site history",
      "description": "Newspaper articles described the building as a ramshackle, barn-like structure whose floors were too rough and warped to cover with linoleum, condemned as entirely inadequate by the Central Council of Civic Clubs' committee on firehouses; an accompanying photograph showed the old hay loft still standing above a modern fire truck.",
      "source": "central-soma-context-statement"
    },
    {
      "date": "1939",
      "kind": "site history",
      "description": "Replaced by a two-storey reinforced concrete station with three vehicle bays, designed with Art Deco and Streamline Moderne influences, now occupied by San Francisco Fire Engine No. 8. The South of Market Historic Resources Survey found it individually eligible for the California Register.",
      "source": "central-soma-context-statement"
    }
  ],
