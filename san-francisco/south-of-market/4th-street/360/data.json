    {
      "date": "1925",
      "kind": "site history",
      "description": "Replaced by the Spanish Colonial Revival Southern Police Station, perhaps the finest Spanish Colonial Revival building in the South of Market. It has been found eligible for the National Register, and was put forward for San Francisco Landmark designation.",
      "source": "central-soma-context-statement"
    },
    {
      "date": "1936",
      "kind": "site history",
      "description": "Works Progress Administration renovations to the station were completed — one of only two WPA projects in the Central SoMa area.",
      "source": "central-soma-context-statement"
    },
    {
      "date": "1970s",
      "kind": "site history",
