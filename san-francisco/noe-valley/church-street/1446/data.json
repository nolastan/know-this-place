  "historical_record": [
    {
      "date": "1973-09-06",
      "kind": "planning decision",
      "description": "The 4,840-square-foot corner property (60 feet on Church, 80 feet on Army) held a building with a vacant non-conforming store on the ground floor and 3 dwelling units above, beside an adjacent vacant lot. The City Planning Commission unanimously approved, with conditions, a nursery school in the lower level of the building with a play yard on the adjacent vacant lot; it voted for up to 22 children, but staff later found the approval could not exceed the 15 advertised.",
