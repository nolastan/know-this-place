  "historical_record": [
    {
      "date": "1927",
      "kind": "construction",
      "description": "Built on Russian Hill overlooking the bay as a two-storey Italian Renaissance house with basement and penthouse, 30 by 52 feet, with a matching garage, designed by John (Giovanni) A. Porporato, a leading Italian-American designer of the city.",
      "source": "nrhp-11000944"
    },
    {
      "date": "1955",
      "kind": "alteration",
      "description": "William Wurster of Wurster, Bernardi & Emmons reorganised the interior, moving the living and dining rooms upstairs and the bedrooms down, to make the house a gallery and a place to entertain artists; the garage became a studio, guest quarters and wine cellar.",
      "source": "nrhp-11000944"
    },
    {
      "date": "1971",
      "kind": "alteration",
      "description": "The front was re-stuccoed to match the original, losing its Corinthian pilasters, medallions and a sill moulding, and the windows were reglazed with single panes.",
      "source": "nrhp-11000944"
    },
    {
      "date": "2011-12-22",
      "kind": "designation",
      "description": "Listed on the National Register of Historic Places for its association with the artist Nell Sinton and for its two architects, Porporato and Wurster.",
      "source": "nrhp-11000944"
    }
  ],
  "notable_residents": [
    {
      "name": "Nell Sinton",
      "period": "1955–1981",
      "detail": "The painter made her abstract expressionist paintings and later feminist constructions here, in a studio converted from the garage.",
      "source": "nrhp-11000944"
    }
  ],
  "building": {
    "name": "Sinton House",
    "architect": "John (Giovanni) A. Porporato"
  }
