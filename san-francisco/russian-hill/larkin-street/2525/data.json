  "historical_record": [
    {
      "date": "1877",
      "kind": "site history",
      "description": "An Italianate house stood on this site from 1877, one of a row of four along the block, with pediments over its paired windows and door. It was demolished in the 1920s to make way for the apartment building here now.",
      "source": "russian-hill-context-statement"
    },
    {
      "date": "1878",
      "kind": "site history",
      "description": "A one-story-plus-raised-basement Italianate house stood on this site from 1878. It was substantially altered in 1894 and again in 1917, ending as a two-story house with classical trim, and came down in 1927.",
      "source": "russian-hill-context-statement"
    },
    {
      "date": "1927",
      "kind": "construction",
      "description": "A mid-rise reinforced-concrete apartment building, one of the three tallest on these blocks and the work of a partnership that specialised in the type. Its ornament survives intact apart from window alterations.",
      "source": "russian-hill-context-statement"
    }
  ],
