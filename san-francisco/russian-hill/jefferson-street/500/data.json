 "historical_record": [
  {
   "date": "1938",
   "kind": "site history",
   "description": "The South End Rowing Club's clubhouse was moved to the east side of Aquatic Park during construction of the Maritime Museum. Founded in 1873, the club had already been moved once — by barge, from the foot of Third Street at Mission Bay to the foot of Van Ness Avenue — and had to fight off industrial interests to keep its waterfront access.",
