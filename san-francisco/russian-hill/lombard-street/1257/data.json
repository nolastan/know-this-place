  "historical_record": [
    {
      "date": "1876",
      "kind": "construction",
      "description": "A flat-front Italianate house built by a carpenter for himself at the rear of the lot, and one of the three best-preserved nineteenth-century buildings on these blocks — essentially unchanged outside. Its French cap, a miniature mansard over the cornice, carries diamond-shaped shingles that repeat on the pent roofs over the door and windows.",
      "source": "russian-hill-context-statement"
    },
    {
      "date": "1904",
      "kind": "construction",
      "description": "Classical Revival flats built at the front of a lot that already held the 1876 cottage behind them, by the architect C. A. Meussdorffer with Ludwig Koenig as contractor. The classical detail is in the arcaded first-story entrance, the casing round the second-story opening, an egg-and-dart course and profiled cornices. Both buildings survive with high integrity.",
      "source": "russian-hill-context-statement"
    }
  ],
