  "historical_record": [
    {
      "date": "1970s",
      "kind": "site history",
      "description": "One of the buildings moved to the Victorian Village development at Sutter and Fillmore in the late 1970s — the former Jimbo's Bop City club from 1690 Post Street — and now home to Marcus Books.",
      "source": "japantown-context-statement"
    },
    {
      "date": "1980",
      "kind": "occupancy",
      "description": "Marcus Books moved into this Victorian-era house in 1980 and stayed for more than three decades, until the owners lost the property to foreclosure in 2013 and the business was evicted the following year. The house had stood at 1690 Post Street, where it held the jazz club Jimbo's Bop City in the 1950s and early 1960s, before being moved here as part of the Victorian Square redevelopment project.",
      "source": "african-american-context-statement"
    },
    {
