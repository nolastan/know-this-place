  "historical_record": [
    {
      "date": "1997-10-16",
      "kind": "planning decision",
      "description": "The City Planning Commission adopted, 5-0 on a voice vote, its determination on the significance of the shadow the planned Scott Street Senior Housing Complex would cast.",
      "source": "sf-planning-commission-minutes-1997-10-16"
    },
    {
      "date": "1997-10-23",
      "kind": "planning decision",
      "description": "The City Planning Commission created the Scott Street Senior Housing Special Use District over the site and approved with conditions, each 6-0, a seven-storey assisted-living complex of 118 dwelling units, 37 residential-care rooms, about 27,200 square feet of offices and about 72 parking spaces, replacing the four-unit residential building at 2180 Post Street (Motions 14481 and 14482).",
      "source": "sf-planning-commission-minutes-1997-10-23"
