  "historical_record": [
    {
      "date": "1925",
      "kind": "occupancy",
      "description": "The Uoki K. Sakai fish market moved here from Geary Boulevard by 1925. It shared the block with a drugstore, a maternity hospital and a book and stationery shop, all established by the late 1920s.",
      "source": "japantown-context-statement"
    },
    {
      "date": "1928",
      "kind": "occupancy",
      "description": "Gosha-do Books and Stationery traded here, and was photographed at this address in 1928. It was a place where people browsed and played cards whether or not they were buying.",
      "source": "japantown-context-statement"
    },
    {
      "date": "1947",
      "kind": "occupancy",
      "description": "Soko Hardware took over the premises after the war, the bookshop having reopened at 1705 Post Street in 1947.",
      "source": "japantown-context-statement"
    }
  ]
