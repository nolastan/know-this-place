  "historical_record": [
    {
      "date": "1933",
      "kind": "site history",
      "description": "Jack's Tavern, known as Jack's of Sutter, opened on this site in 1933 in a mixed neighbourhood of African Americans, Japanese, Filipinos and Jews — the first of the Fillmore's Big Three prewar nightclubs. Club Alabama, run by the impresario Lester Mapp, followed in the same building. Neither remains.",
      "source": "african-american-context-statement"
    }
  ],
