  "historical_record": [
    {
      "date": "1935–1941",
      "kind": "alteration",
      "description": "Works Progress Administration workers remodelled the police training academy here in Golden Gate Park and graded and paved a parking lot for it. The building is now the Golden Gate Park Senior Center.",
      "source": "new-deal-context-statement"
    },
    {
      "date": "1935–1941",
      "kind": "public works",
      "description": "The Works Progress Administration added a one-storey concrete extension to Kezar Pavilion and replaced the stadium's wooden seating with concrete seating for 60,000 spectators.",
      "source": "new-deal-context-statement"
    },
    {
      "date": "1935–1941",
      "kind": "public works",
      "description": "The Works Progress Administration began the preliminary planning of the arboretum in Golden Gate Park.",
      "source": "new-deal-context-statement"
    },
    {
      "date": "1937",
      "kind": "artwork",
      "description": "The Beach Chalet holds a group of 1937 Federal Art Project works: Lucien Labaudt's San Francisco Scenes frescoes and monochrome frescoes, a mosaic by Primo Caredio and magnolia-wood carvings of sea creatures by Michael von Meyer. It is City Landmark No. 179.",
      "source": "new-deal-context-statement"
    },
    {
      "date": "1888",
      "kind": "construction",
      "description": "The Sharon Building went up at 300 Bowling Green Drive as a canteen for women and children, and is now a community art centre. One of the few Richardsonian Romanesque buildings in the city and the only local example with rough-hewn stone walls, it is City Landmark No. 124.",
      "source": "victorian-era-styles-context-statement"
    }
  ],
