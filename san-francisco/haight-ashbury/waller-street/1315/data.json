  "historical_record": [
    {
      "date": "1896",
      "kind": "construction",
      "description": "Built as the family home of John A. Whelan, a shipwright and speculative builder, the easternmost of four matching Queen Anne houses he put up on this block — the Four Seasons Houses, of which this is Winter, for the snowflake relief on its front. It was first numbered 1305 Waller Street; its architect or builder is unknown.",
      "source": "nrhp-100005794"
    },
    {
      "date": "1920",
      "kind": "alteration",
      "description": "The front stairs were rebuilt in brick out to the property line and the basement made into a garage.",
      "source": "nrhp-100005794"
    },
    {
      "date": "1978",
      "kind": "alteration",
      "description": "A renovation with the designer Paul Duchscherer of Bradbury & Bradbury, partly paid for by the city's Upper Ashbury Rehabilitation Assistance Program loans, turned the house back from three flats into a single family house and repainted its front in the Colorist blues it still largely carries.",
      "source": "nrhp-100005794"
    },
    {
      "date": "1993",
      "kind": "alteration",
      "description": "The front stair was rebuilt to match those of the other three Four Seasons Houses, and brick veneer was taken off around the garage.",
      "source": "nrhp-100005794"
    },
    {
      "date": "2020-11-20",
      "kind": "designation",
      "description": "Listed on the National Register of Historic Places for the peak years of the Haight Ashbury's residential building and as an excellent Queen Anne house.",
      "source": "nrhp-100005794"
    }
  ],
