  "historical_record": [
    {
      "date": "1896",
      "kind": "construction",
      "description": "Built as Divisadero Hall, a meeting place for the Olympus Parlor of the Native Sons of the Golden West and, over the years, for many other fraternal and social groups. One of the few purpose-built fraternal lodges and social halls in the city to predate the 1906 earthquake and survive it.",
      "source": "clubs-social-halls-context-statement"
    },
    {
      "date": "1953",
      "kind": "occupancy",
      "description": "A Chekhov festival was staged here in 1953, jointly sponsored by the Russian American Society and the American Russian Institute.",
      "source": "russian-american-context-statement"
    },
    {
      "date": "1966-01",
      "kind": "site history",
      "description": "The San Francisco Tape Music Center held a late-night Worship Service here as one of the Trips Festival's after-hours side trips in January 1966.",
