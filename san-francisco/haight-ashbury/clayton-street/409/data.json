  "historical_record": [
    {
      "date": "1967",
      "kind": "occupancy",
      "description": "The Haight Ashbury Free Clinic leased a second building here for psychiatric services and a publishing arm. The ground floor became Happening House, and from 1967 the Ecumenical Ministry to the Haight — the 409 House, described as the country's first drop-in centre — worked from the first floor. A meeting here in October 1967 produced the proposal for the Death of the Hippie ceremony.",
      "source": "counterculture-context-statement"
    }
