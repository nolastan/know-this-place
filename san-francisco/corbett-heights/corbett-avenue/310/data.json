  "historical_record": [
    {
      "date": "1962-04-20",
      "kind": "construction",
      "description": "Plans drawn by the architect Jonathan D. Buckley: a house of irregular shapes and angles, avoiding squares and rectangles down to the pool in the rear garden.",
