  "historical_record": [
    {
      "date": "1974-07-11",
      "kind": "planning decision",
      "description": "The 10,000-square-foot corner lot held a one-storey office building of about 4,370 square feet, used as a child psychiatric clinic of the city's Department of Public Health, with a parking lot and yard. The City Planning Commission unanimously approved, with nine conditions, converting the office building to a nursery and primary school (Pacific Primary) for children aged 2 to 8, with the parking lot and yard turned into about 5,630 square feet of play space.",
