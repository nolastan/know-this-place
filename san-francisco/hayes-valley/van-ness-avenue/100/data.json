  "historical_record": [
    {
      "date": "1970-06-18",
      "kind": "planning decision",
      "description": "The corner lot at Van Ness Avenue and Fell Street was then vacant, a former gasoline service station recently bought from Standard Oil by the California State Automobile Association, which planned an office building there. The City Planning Commission approved, with six conditions, an interim parking lot of 44 tandem spaces on the vacant corner at Van Ness Avenue and Fell Street, though the hearing was afterwards reopened so the applicant could answer the conditions.",
      "source": "sf-planning-commission-minutes-1970-06-18"
    },
    {
      "date": "1970-08-06",
      "kind": "planning decision",
      "description": "The California State Automobile Association had bought the site in 1968 for a new office building; its service station had been cleared and the lot was to serve as a parking lot. The City Planning Commission approved, with conditions, an interim parking lot on the site for five years, allowing a billboard and an alternate landscaping plan, the permit to end if the auto association sold the property.",
      "source": "sf-planning-commission-minutes-1970-08-06"
    }
  ]
