  "historical_record": [
    {
      "date": "1989",
      "kind": "occupancy",
      "description": "A building put up for the Acme Brewing Company, used as the San Francisco Redevelopment Agency's Western Addition field office through the redevelopment years and turned over to the community in the late 1980s. The African American Art and Culture Complex moved in in 1989 — one of the city's six cultural centres, with galleries, a 206-seat theatre, dance studios and a conference room — and the San Francisco African American Historical and Cultural Society is housed here. Murals were painted at the centre in 1984 and 1996. Identified in 2024 as eligible for local landmark, California Register or National Register designation.",
      "source": "african-american-context-statement"
    }
  ]
