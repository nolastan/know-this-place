  "historical_record": [
    {
      "date": "1890–1900",
      "kind": "site history",
      "description": "Built on the west side of Minnesota Street between 20th and 22nd Streets, one of seven identical duplexes and cottages the Santa Fe Land Improvement Company put up to John Cotter Pelton, Jr.'s published plans and rented to railroad workers.",
      "source": "dogpatch-context-statement"
    },
    {
      "date": "1900",
      "kind": "relocation",
      "description": "Moved to the 1000 block of Tennessee Street after the company redeveloped the Minnesota Street lot with the Schilling Wine Warehouse. Five of the row went to the 2400 block of Kentucky Street and were demolished when that street was widened in the 1930s.",
      "source": "dogpatch-context-statement"
    }
  ],
  "historic_survey": {
    "survey": "Dogpatch Historic District Survey (2001)",
    "note": "One of two of the company's Pelton-plan cottages still standing in 2001, and the subject of a DPR 523B form on file at San Francisco Architectural Heritage.",
