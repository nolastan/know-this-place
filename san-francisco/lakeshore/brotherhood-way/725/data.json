  "historical_record": [
    {
      "date": "1977-09-01",
      "kind": "occupancy",
      "description": "The 46,625-square-foot lot then here, between the Jewish Community Center and the Lake Merced Church of Christ, was vacant with a gravel surface; a graduate school of psychology authorised on it in 1975 was never built.",
      "source": "sf-planning-commission-minutes-1977-09-01"
    },
    {
      "date": "1977-11-10",
      "kind": "planning decision",
      "description": "Over the objection of the churches along Brotherhood Way, the City Planning Commission voted 6 to 1 to rezone the vacant lot then here from R-1-D to R-4 for a privately run home for the elderly of about 100 rooms (Resolution 7842).",
      "source": "sf-planning-commission-minutes-1977-11-10"
