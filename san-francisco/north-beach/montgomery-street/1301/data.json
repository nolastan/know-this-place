  "historical_record": [
    {
      "date": "1859",
      "kind": "construction",
      "description": "The Italianate house at 1303 Montgomery dates to 1859 and was remodeled in 1926; its first owner was John Allen, a drayman. One of the Telegraph Hill houses that came through the 1906 fire.",
      "source": "sf-neighborhood-newspapers-thesemaphore2006spring175-n15"
    },
    {
      "date": "1853",
      "kind": "construction",
      "description": "The corner building at 1301 Montgomery is a brick commercial building, now covered in stucco, that appears on the U.S. Coast Survey map of 1853 and may be the city's oldest brick building still standing. Its first known use was likely as the salesroom and manufactory of Dr. David G. \"Yankee\" Robinson's Vegetable Bitters, advertised in the 1852 directory; it held a grocery from 1881 to 1886 and, in the 1920s, a pool hall inside John Ortega's Soft Drinks, the Prohibition stand-in for a saloon.",
      "source": "sf-neighborhood-newspapers-thesemaphore2016autumn215-n8"
    }
