  "historical_record": [
    {
      "date": "1959-03",
      "kind": "demolition",
      "description": "Five little houses were built in the 1870s on the east side of this block of Montgomery Street, below street level and at slightly odd angles to each other. One was torn down in 1939 and another moved to Greenwich Street to make way for a large apartment building; the last three were condemned and torn down in March 1959.",
      "source": "sf-neighborhood-newspapers-telegraphhillbulletin1959july-n1"
    },
    {
      "date": "1959",
      "kind": "construction",
      "description": "After the old houses came down the lot was sold at auction for a four-unit apartment building designed by Gardner Dailey, set back from the street to allow planting, with a garage and a deck facing the East Bay.",
      "source": "sf-neighborhood-newspapers-telegraphhillbulletin1959july-n1"
    }
  ]
