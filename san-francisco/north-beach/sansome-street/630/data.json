  "historical_record": [
    {
      "date": "1944",
      "kind": "construction",
      "description": "A sixteen-storey reinforced-concrete federal office building put up by the Public Works Administration on the site of the 1874 Appraisers Building, which was demolished in 1940. The Office of the Supervising Architect under Gilbert Stanley Underwood designed it in the PWA Moderne style; wartime rationing delayed its official opening until 1944, a year after the PWA was wound up. Its only notable ornament is an American eagle over the main entrance by Lombard & Ludwig. It was remodelled in 1985-88 by Kaplan McLaughlin Diaz and is listed in the National Register.",
      "source": "new-deal-context-statement"
