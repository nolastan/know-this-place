  "historical_record": [
    {
      "date": "1853",
      "kind": "construction",
      "description": "John Cooney, born in Ireland, bought the lot in 1850 for $140 and finished the house in 1853, with wood the family is said to have brought from Australia; he then opened a grocery on the ground floor, the first and for a while the only one on top of the hill. The store lasted until 1906 and the family kept the building until 1937. Its Italianate false front was likely added in the 1880s. The Semaphore calls it the oldest surviving residential building in San Francisco.",
      "source": "sf-neighborhood-newspapers-thesemaphore2016autumn215-n8"
    }
