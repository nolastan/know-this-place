  },
  {
   "date": "1949",
   "kind": "occupancy",
   "description": "The Paper Doll operated here between 1949 and 1961, one of the North Beach bars and restaurants the city's survey identifies as significant in San Francisco's LGBTQ history.",
   "source": "north-beach-context-statement"
  },
  {
   "date": "1949",
   "kind": "occupancy",
   "description": "The Paper Doll, among the first restaurants in the city to serve an openly queer clientele, took the ground floor of this two-storey wood-frame building beside Cadell Place in 1949; murals inside were reportedly painted by North Beach artists including Emmy Lou Packard.",
   "source": "lgbtq-context-statement"
  },
  {
