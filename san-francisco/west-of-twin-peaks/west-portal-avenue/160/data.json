  "historical_record": [
    {
      "date": "1943",
      "kind": "alteration",
      "description": "The Graysons clothing store here was fitted out to a design by Victor Gruen and Elsie Krummeck, the partnership whose storefront prototype Pittco distributed free to merchants and whose senior partner went on to invent the shopping mall; it was photographed about 1943, soon after completion. The store has since been divided into four shops, and its generous side show windows survive.",
      "source": "neighborhood-commercial-context-statement"
