  "historical_record": [
    {
      "date": "1970-06-04",
      "kind": "planning decision",
      "description": "A Phillips Petroleum service station stood at the corner of Ocean Avenue and Junipero Serra Boulevard, with a Hertz car rental agency trading from it without a permit and a City-owned strip to the west leased for parking. The City Planning Commission approved, with seven conditions including a landscaped strip along Junipero Serra Boulevard, open storage and display of rental cars at the service station at Ocean Avenue and Junipero Serra Boulevard.",
      "source": "sf-planning-commission-minutes-1970-06-04"
