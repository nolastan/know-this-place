  "historical_record": [
    {
      "date": "1935–1941",
      "kind": "alteration",
      "description": "Works Progress Administration workers reconditioned the wards of the Laguna Honda Home for the Aged and Infirm to improve capacity and comfort. New Deal artists worked on the campus too: Glen Wessels painted five murals in the main lobby — The Professions and Earth, Air, Water and Fire — and David Lindstrom carved a cast-stone Florence Nightingale for the main entrance.",
      "source": "new-deal-context-statement"
