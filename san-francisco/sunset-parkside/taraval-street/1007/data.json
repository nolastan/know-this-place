  "historical_record": [
    {
      "date": "1979-02-08",
      "kind": "occupancy",
      "description": "In February 1979 the site held a branch bank of 6,000 square feet and two adjoining commercial properties, which a proposed 15,500-square-foot branch bank with a 25-car underground garage would have replaced.",
      "source": "sf-planning-commission-minutes-1979-02-08"
    },
    {
      "date": "1979-05-24",
      "kind": "planning decision",
      "description": "Having denied an appeal of its negative declaration (Resolution 8278), the City Planning Commission unanimously refused the permit for Bank of America's new 15,500-square-foot branch with a 25-car garage, which would have replaced the existing branch and two neighbouring commercial buildings, and told the bank to consider a smaller building (Resolution 8279); it also refused to abolish the 15-foot setback along 20th Avenue (Resolution 8280).",
      "source": "sf-planning-commission-minutes-1979-05-24"
    }
