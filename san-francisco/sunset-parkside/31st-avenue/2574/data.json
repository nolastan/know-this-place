  "historical_record": [
    {
      "date": "1908",
      "kind": "construction",
      "description": "Built by the Parkside Realty Company as one of 62 near-identical cottages put up across seven blocks to bring the first residents into the new district — about 800 square feet on one storey, two bedrooms and a bath, sold with a choice of six façade treatments over a single plan. All but one of the group was still standing a century later, almost all of them raised over a basement garage in the meantime.",
      "source": "parkside-context-statement"
