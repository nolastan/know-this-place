  "historical_record": [
    {
      "date": "1911",
      "kind": "construction",
      "description": "One of a row of fifteen Craftsman houses Alonzo Harrington built along this block between 1911 and 1913 — one of only two long rows put up in the neighbourhood before 1915. The row is largely intact, and this house has been restored, with earlier unsympathetic modernisations reversed.",
      "source": "oceanside-context-statement"
    },
    {
      "date": "1911",
      "kind": "construction",
      "description": "Built by Alphonso Harrington, part of the row of fifteen Craftsman houses he raised along the west side of 42nd Avenue near Lincoln Way between 1910 and 1915 — one of the best surviving collections of early Outer Sunset houses, and the core of the Alphonso Harrington 42nd Avenue Historic District.",
      "source": "architecture-preservation-professionals-biographies"
